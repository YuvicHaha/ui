local function monitor(p)
    local function char(c)
        c:GetAttributeChangedSignal("HasHandcuffs"):Connect(function()
            if c:GetAttribute("HasHandcuffs") then arrestedBlacklist[p] = true end
        end)
    end
    if p.Character then char(p.Character) end
    p.CharacterAdded:Connect(char)
end
for _, p in ipairs(Players:GetPlayers()) do monitor(p) end
Players.PlayerAdded:Connect(monitor)

local function EquipHandcuffs()
    local invSys = require(RS.Inventory.InventoryItemSystem)
    for _, item in pairs(invSys.getInventoryItemsFor(LP)) do
        if item.obj and item.obj.Name == "Handcuffs" then
            pcall(function() item:AttemptSetEquipped(true) end)
            return true
        end
    end
    return false
end

local function EjectNearestVehicleUser()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local vehicles = workspace:FindFirstChild("Vehicles")
    if not hrp or not vehicles then return end
    local nearest, minDist = nil, Config.VehicleEnterRange + 10
    for _, v in pairs(vehicles:GetChildren()) do
        local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
        if seat and (hrp.Position - seat.Position).Magnitude < minDist then
            minDist, nearest = (hrp.Position - seat.Position).Magnitude, v
        end
    end
    if not nearest then return end
    local uiModule = RS:FindFirstChild("Module", true) and require(RS.Module:FindFirstChild("UI", true) or RS.Module)
    if uiModule and uiModule.CircleAction and uiModule.CircleAction.Specs then
        for _, spec in pairs(uiModule.CircleAction.Specs) do
            if (spec.Part and (nearest:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(nearest))) or (spec.Text and (spec.Text:lower():find("eject") or spec.Text:lower():find("passenger"))) then
                pcall(function() spec:Callback(true) end)
                return
            end
        end
    end
end

local function SpawnCamaro(hrp)
    local spawnRemote = RS:FindFirstChild("GarageSpawnVehicle", true)
    if spawnRemote then
        hrp.CFrame = hrp.CFrame + Vector3.new(0, Config.SpawnCamaroUpward, 0)
        task.wait(0.5)
        hrp.CFrame = hrp.CFrame + Vector3.new(0, -Config.SpawnCamaroUpward, Config.SpawnCamaroDistance)
        task.wait(1)
        spawnRemote:FireServer("Chassis", "Camaro")
        task.wait(1.5)
    end
end

local function InVehicle()
    if not LP.Character then return false end
    return LP.Character:GetAttribute("InVehicle") or (LP.Character:FindFirstChild("Humanoid") and LP.Character.Humanoid.SeatPart ~= nil)
end

local function EnterNearestVehicle()
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    for _, v in pairs(workspace.Vehicles:GetChildren()) do
        if v:FindFirstChild("Seat") and (v.Seat.Position - hrp.Position).Magnitude < Config.VehicleEnterRange then
            for _, spec in pairs(require(RS.Module.UI).CircleAction.Specs) do
                if spec.Part and spec.Part == v.Seat then
                    spec:Callback(true)
                    return v
                end
            end
        end
    end
end

local function CheckObstacle(pos, dir, dist)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LP.Character, workspace.Vehicles}
    params.FilterType = Enum.RaycastFilterType.Exclude
    return workspace:Raycast(pos, dir * dist, params)
end

local function FlyTo(targetPos)
    local hrp = LP.Character.HumanoidRootPart
    local BodyGyro = Instance.new("BodyGyro", hrp)
    local BodyVelocity = Instance.new("BodyVelocity", hrp)
    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.D, BodyGyro.P = 500, 150000
    while getgenv().AutoArrestActive and (hrp.Position - targetPos).Magnitude > 10 do
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") or LP.Character.Humanoid.Health <= 0 then break end
        if CheckObstacle(hrp.Position, (targetPos - hrp.Position).Unit, 5) then
            LP.Character:BreakJoints()
            break
        end
        BodyVelocity.Velocity = (targetPos - hrp.Position).Unit * Config.FlightSpeed
        BodyGyro.CFrame = CFrame.new(hrp.Position, targetPos)
        task.wait()
    end
    BodyGyro:Destroy()
    BodyVelocity:Destroy()
end

local function MainLogic()
    while getgenv().AutoArrestActive do
        task.wait(Config.MainLoopDelay)
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") or LP.Character.Humanoid.Health <= 0 then continue end
        local hrp = LP.Character.HumanoidRootPart
        local closestBase, baseDist, selectedPath = nil, math.huge, nil
        for name, data in pairs(PoliceData) do
            local d = (hrp.Position - data.Base).Magnitude
            if d < baseDist then baseDist, closestBase, selectedPath = d, data.Base, data.Path end
        end
        if baseDist < Config.PathfindTriggerDist and not InVehicle() then
            for _, wp in ipairs(selectedPath) do
                hrp.CFrame = CFrame.new(wp)
                task.wait(Config.WaypointInterval)
            end
        end
        if not InVehicle() then
            rememberedCar = EnterNearestVehicle()
            task.wait(1)
        end
        if InVehicle() then
            if CheckObstacle(hrp.Position, Vector3.new(0, 1, 0), Config.FlightHeight) then LP.Character:BreakJoints() continue end
            FlyTo(hrp.Position + Vector3.new(0, Config.FlightHeight, 0))
            local target, targetRoot, minDist = nil, nil, math.huge
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character and plr.Team and plr.Team.Name == "Criminal" and not arrestedBlacklist[plr] then
                    local root = plr.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local inAirVehicle = false
                        if plr.Character:GetAttribute("InVehicle") then
                            for _, v in pairs(workspace.Vehicles:GetChildren()) do
                                local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
                                if seat and (seat.Position - root.Position).Magnitude < 15 then
                                    local vn = v.Name:lower()
                                    if vn:find("heli") or vn:find("drone") or vn:find("blimp") or vn:find("blackhawk") then inAirVehicle = true end
                                end
                            end
                        end
                        if not inAirVehicle and (root.Position - hrp.Position).Magnitude < minDist then
                            minDist, target, targetRoot = (root.Position - hrp.Position).Magnitude, plr, root
                        end
                    end
                end
            end
            if targetRoot then
                FlyTo(Vector3.new(targetRoot.Position.X, hrp.Position.Y, targetRoot.Position.Z))
                if CheckObstacle(hrp.Position, Vector3.new(0, -1, 0), math.abs(hrp.Position.Y - targetRoot.Position.Y)) then LP.Character:BreakJoints() continue end
                FlyTo(targetRoot.Position + Vector3.new(0, 5, 0))
                if target.Character:GetAttribute("InVehicle") then
                    local rStart = tick()
                    while getgenv().AutoArrestActive and tick() - rStart < Config.MaxRamDuration and target.Character:GetAttribute("InVehicle") do
                        pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", targetRoot) end)
                        hrp.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 0)
                        task.wait()
                    end
                    EjectNearestVehicleUser()
                    task.wait(0.5)
                end
                if (hrp.Position - targetRoot.Position).Magnitude <= Config.ArrestRange then
                    pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", targetRoot) end)
                    hrp.CFrame = targetRoot.CFrame * Config.ArrestTpOffset
                    EquipHandcuffs()
                    task.wait(0.2)
                    if attemptArrest then pcall(function() attemptArrest(target) end) end
                    task.wait(0.5)
                    if arrestedBlacklist[target] then
                        FlyTo(hrp.Position + Vector3.new(0, Config.PostArrestHover, 0))
                        if rememberedCar and rememberedCar:FindFirstChild("Seat") and (hrp.Position - rememberedCar.Seat.Position).Magnitude < Config.MaxCarRecoveryDist then
                            FlyTo(Vector3.new(rememberedCar.Seat.Position.X, hrp.Position.Y, rememberedCar.Seat.Position.Z))
                            FlyTo(rememberedCar.Seat.Position)
                            EnterNearestVehicle()
                        else
                            SpawnCamaro(hrp)
                            EnterNearestVehicle()
                        end
                    end
                end
            end
        end
    end
end
task.spawn(MainLogic)
