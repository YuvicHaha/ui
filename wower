        State.character = nil
        State.humanoid = nil
        State.root = nil
        State.vehicle = nil
        State.vehicleEntered = false
        State.target = nil
        State.targetCharacter = nil
        State.targetRoot = nil
        State.targetVehicle = nil
    end
end))

table.insert(Connections, RunService.Heartbeat:Connect(function()
    if not Config.Enabled then
        if State.flight then
            cleanupFlight()
        end
        return
    end

    local generation = State.generation

    if State.character
        and LocalPlayer.Character ~= State.character then

        cancelSession()
        cleanupFlight()
        setState("STOPPED")
        return
    end

    if State.character and not currentCharacterValid(generation) then
        cleanupFlight()
        return
    end

    if currentCharacterValid(generation) then
        updateRememberedVehicle(generation)
        State.vehicleEntered = vehicleEntered()
    end
end))

local function monitorPlayer(player)
    if player == LocalPlayer then
        return
    end

    if player:GetAttribute("PoliceAutomationMonitorInstalled") then
        return
    end

    pcall(function()
        player:SetAttribute("PoliceAutomationMonitorInstalled", true)
    end)

    local function attach(character)
        if not character then
            return
        end

        local connection = character:GetAttributeChangedSignal("HasHandcuffs"):Connect(function()
            if character:GetAttribute("HasHandcuffs") == true then
                arrestedBlacklist[player] = true
            end
        end)

        table.insert(Connections, connection)

        if character:GetAttribute("HasHandcuffs") == true then
            arrestedBlacklist[player] = true
        end
    end

    if player.Character then
        attach(player.Character)
    end

    local characterConnection = player.CharacterAdded:Connect(attach)
    table.insert(Connections, characterConnection)

    local removingConnection = player.AncestryChanged:Connect(function(_, parent)
        if not parent then
            arrestedBlacklist[player] = nil
        end
    end)

    table.insert(Connections, removingConnection)
end

for _, player in ipairs(Players:GetPlayers()) do
