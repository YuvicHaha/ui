local attemptArrest = nil
for _, v in pairs(getgc(true)) do
    if type(v) == "function" and islclosure(v) then
        pcall(function()
            if tostring(getinfo(v).name) == "AttemptArrest" then
                attemptArrest = v
            end
        end)
        if attemptArrest then break end
    end
end

local automationGeneration = 0
local currentState = "Stopped"
local arrestedBlacklist = {}
local lastExitedVehicle = nil
local currentTarget = nil
local currentVehicle = nil

local function CheckGen(gen)
    return getgenv().AutoArrestActive and automationGeneration == gen
end

local function SetState(newState)
    currentState = newState
end

local function CleanupPhysics(rootPart)
    if not rootPart then return end
    for _, v in pairs(rootPart:GetChildren()) do
        if v:IsA("BodyGyro") or v:IsA("BodyVelocity") then
            v:Destroy()
        end
    end
end

local function GetCharacterRoot()
    if not LocalPlayer.Character then return nil end
    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
    if root and hum and hum.Health > 0 then
        return root, hum
    end
    return nil
end

local function CheckObstacle(rootPart, direction, distance)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, workspace:FindFirstChild("Vehicles")}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(rootPart.Position, direction * distance, params)
    return result ~= nil
end

local function HandleObstacle(gen)
    local _, hum = GetCharacterRoot()
    if hum then hum.Health = 0 end 
end

local function CreateFlight(rootPart)
    CleanupPhysics(rootPart)
    local bg = Instance.new("BodyGyro", rootPart)
    local bv = Instance.new("BodyVelocity", rootPart)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.D = 500
    bg.P = 150000
    return bg, bv
end

local function IsTargetValid(plr)
    if plr == LocalPlayer then return false end
    if arrestedBlacklist[plr] then return false end
    if not plr.Character then return false end
    
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    local hum = plr.Character:FindFirstChild("Humanoid")
    if not root or not hum or hum.Health <= 0 then return false end
    
    if plr.Team and plr.Team.Name ~= "Criminal" then return false end
    
    if plr.Character:GetAttribute("InVehicle") then
        local vehiclesDir = Workspace:FindFirstChild("Vehicles")
        if vehiclesDir then
            for _, v in pairs(vehiclesDir:GetChildren()) do
                local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
                if seat and (seat.Position - root.Position).Magnitude < 15 then
                    local vName = v.Name:lower()
                    if vName:find("heli") or vName:find("drone") or vName:find("blimp") or vName:find("ufo") or vName:find("blackhawk") then
                        return false
                    end
                end
            end
        end
    end
    
    return true
end

local function EquipHandcuffs()
    if Modules.InventorySys then
        for _, item in pairs(Modules.InventorySys.getInventoryItemsFor(LocalPlayer)) do
            if item.obj and item.obj.Name == "Handcuffs" then
                pcall(function() item:AttemptSetEquipped(true) end)
                return true
            end
        end
    end
    return false
end

local function GetTargetVehicle(plrChar)
    if not plrChar:GetAttribute("InVehicle") then return nil end
    local root = plrChar:FindFirstChild("HumanoidRootPart")
    local vehiclesDir = Workspace:FindFirstChild("Vehicles")
    if root and vehiclesDir then
        for _, v in pairs(vehiclesDir:GetChildren()) do
            local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
            if seat and (seat.Position - root.Position).Magnitude < 15 then
                return v
            end
        end
    end
    return nil
end

local function EnterNearestVehicle(targetVeh, gen)
    local root, hum = GetCharacterRoot()
    if not root then return false end

    if Modules.UI and Modules.UI.CircleAction and Modules.UI.CircleAction.Specs then
        local seat = targetVeh:FindFirstChild("Seat") or targetVeh:FindFirstChild("VehicleSeat")
        for _, spec in pairs(Modules.UI.CircleAction.Specs) do
            if spec.Part and (spec.Part == seat or spec.Part:IsDescendantOf(targetVeh)) then
                pcall(function() spec:Callback(true) end)
                break
            end
        end
    end

    local start = tick()
    while tick() - start < Config.VehicleEntryTimeout and CheckGen(gen) do
        if LocalPlayer.Character:GetAttribute("InVehicle") or hum.SeatPart ~= nil then
            currentVehicle = targetVeh
            lastExitedVehicle = targetVeh
            return true
        end
        task.wait()
    end
    return false
end

local function EjectTarget(targetPlr, gen)
    if Modules.UI and Modules.UI.CircleAction and Modules.UI.CircleAction.Specs then
        local tVeh = GetTargetVehicle(targetPlr.Character)
        if not tVeh then return end
        
        for _, spec in pairs(Modules.UI.CircleAction.Specs) do
            local isMatch = false
            if spec.Part and (tVeh:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(tVeh)) then
                isMatch = true
            elseif spec.Text and (spec.Text:lower():find("eject") or spec.Text:lower():find("passenger")) then
                isMatch = true
            end
            
            if isMatch then
                pcall(function() spec:Callback(true) end)
            end
        end
    end
end

local function AutomationCycle(gen)
    while CheckGen(gen) do
        local root, hum = GetCharacterRoot()
        if not root then 
            task.wait(1)
            continue 
        end

        if currentState == "Initializing" then
            CleanupPhysics(root)
            currentTarget = nil
            SetState("ExitingBuilding")

        elseif currentState == "ExitingBuilding" then
            local closestPath, minDist = nil, 200
            for _, stationData in pairs(PoliceData) do
                local dist = (root.Position - stationData.Base).Magnitude
                if dist < minDist then
                    closestPath = stationData.Path
                    minDist = dist
                end
            end
            
            if closestPath then
                for _, pt in ipairs(closestPath) do
                    if not CheckGen(gen) then return end
                    root.CFrame = CFrame.new(pt)
                    task.wait(Config.OutsidePathDelay)
                end
            end
            SetState("FindingVehicle")

        elseif currentState == "FindingVehicle" then
            local vehiclesDir = Workspace:FindFirstChild("Vehicles")
            local bestVeh, bestDist = nil, Config.VehicleSearchRadius
            if vehiclesDir then
                for _, v in pairs(vehiclesDir:GetChildren()) do
                    local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat")
                    if seat and not seat.Occupant then
                        local dist = (seat.Position - root.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestVeh = v
                        end
                    end
                end
            end
            
            if bestVeh then
                currentVehicle = bestVeh
                SetState("ApproachingVehicle")
            else
                task.wait(1)
            end

        elseif currentState == "ApproachingVehicle" then
            if not currentVehicle or not currentVehicle.Parent then
                SetState("FindingVehicle")
                continue
            end
            local seat = currentVehicle:FindFirstChild("Seat") or currentVehicle:FindFirstChild("VehicleSeat")
            if not seat or seat.Occupant then
                SetState("FindingVehicle")
                continue
            end
            
            local bg, bv = CreateFlight(root)
            
            local targetY = root.Position.Y + Config.InitialVehicleAscendHeight
            bv.Velocity = Vector3.new(0, Config.AscendSpeed, 0)
            bg.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(1,0,0))
            
            while root.Position.Y < targetY and CheckGen(gen) do
                if CheckObstacle(root, Vector3.new(0,1,0), 10) then HandleObstacle(gen); return end
                task.wait()
            end
            
            local start = tick()
            while CheckGen(gen) do
                local toSeat = (seat.Position * Vector3.new(1,0,1)) + Vector3.new(0, targetY, 0)
                local dir = toSeat - root.Position
                if dir.Magnitude < 5 or tick() - start > 15 then break end
                bv.Velocity = dir.Unit * Config.HorizontalSpeed
                bg.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
                task.wait()
            end
            
            bv.Velocity = Vector3.new(0, -Config.DescendSpeed, 0)
            bg.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(1,0,0))
            while (root.Position.Y - seat.Position.Y) > 5 and CheckGen(gen) do
                if CheckObstacle(root, Vector3.new(0,-1,0), 10) then break end
                task.wait()
            end
            
            CleanupPhysics(root)
            SetState("EnteringVehicle")

        elseif currentState == "EnteringVehicle" then
            if EnterNearestVehicle(currentVehicle, gen) then
                SetState("Ascending")
            else
                SetState("FindingVehicle")
            end

        elseif currentState == "Ascending" then
            if not LocalPlayer.Character:GetAttribute("InVehicle") and hum.SeatPart == nil then
                SetState("FindingVehicle")
                continue
            end
            
            local bg, bv = CreateFlight(root)
            local targetY = root.Position.Y + Config.TargetSearchAltitude
            bv.Velocity = Vector3.new(0, Config.AscendSpeed, 0)
            bg.CFrame = root.CFrame
            
            while root.Position.Y < targetY and CheckGen(gen) do
                if CheckObstacle(root, Vector3.new(0,1,0), 20) then HandleObstacle(gen); return end
                if not LocalPlayer.Character:GetAttribute("InVehicle") then break end
                task.wait()
            end
            
            bv.Velocity = Vector3.zero
            SetState("FindingTarget")

        elseif currentState == "FindingTarget" then
            local bestTarg, bestDist = nil, math.huge
            for _, plr in pairs(Players:GetPlayers()) do
                if IsTargetValid(plr) then
                    local tRoot = plr.Character.HumanoidRootPart
                    local dist = (tRoot.Position - root.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestTarg = plr
                    end
                end
            end
            
            if bestTarg then
                currentTarget = bestTarg
                SetState("ApproachingTarget")
            else
                task.wait(1)
            end

        elseif currentState == "ApproachingTarget" then
            if not currentTarget or not IsTargetValid(currentTarget) then
                SetState("FindingTarget")
                continue
            end
            
            local tRoot = currentTarget.Character.HumanoidRootPart
            local bg, bv = CreateFlight(root)
            
            local start = tick()
            while CheckGen(gen) do
                if not IsTargetValid(currentTarget) then SetState("FindingTarget"); break end
                
                local tPos = tRoot.Position
                local targetH = Vector3.new(tPos.X, root.Position.Y, tPos.Z)
                local dir = targetH - root.Position
                
                if dir.Magnitude < 10 or tick() - start > Config.TargetTimeout then break end
                
                bv.Velocity = dir.Unit * Config.HorizontalSpeed
                bg.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
                task.wait()
            end
            
            if currentState == "ApproachingTarget" then
                SetState("DescendingToTarget")
            end

        elseif currentState == "DescendingToTarget" then
            if not IsTargetValid(currentTarget) then
                SetState("FindingTarget")
                continue
            end
            
            local bg, bv = CreateFlight(root)
            local start = tick()
            
            while CheckGen(gen) do
                if not IsTargetValid(currentTarget) then SetState("FindingTarget"); break end
                
                local tRoot = currentTarget.Character.HumanoidRootPart
                local dist = (tRoot.Position - root.Position).Magnitude
                
                if dist <= Config.TargetCloseDistance or tick() - start > Config.TargetTimeout then
                    break
                end
                
                local dir = (tRoot.Position - root.Position).Unit
                bv.Velocity = Vector3.new(dir.X * Config.HorizontalSpeed, -Config.DescendSpeed, dir.Z * Config.HorizontalSpeed)
                bg.CFrame = CFrame.lookAt(root.Position, Vector3.new(tRoot.Position.X, root.Position.Y, tRoot.Position.Z))
                task.wait()
            end
            
            CleanupPhysics(root)
            if currentState == "DescendingToTarget" then
                SetState("PoppingTires")
            end

        elseif currentState == "PoppingTires" then
            if not IsTargetValid(currentTarget) then
                SetState("FindingTarget")
                continue
            end
            
            local tChar = currentTarget.Character
            local tRoot = tChar.HumanoidRootPart
            local tVeh = GetTargetVehicle(tChar)
            
            if tVeh then
                local initialPop = tVeh:GetAttribute("VehicleTiresLastPop")
                local start = tick()
                while CheckGen(gen) and tick() - start < Config.TirePopTimeout do
                    if not IsTargetValid(currentTarget) then break end
                    pcall(sethiddenproperty, root, "PhysicsRepRootPart", tRoot)
                    root.CFrame = tRoot.CFrame * Config.TpOffset
                    if tVeh:GetAttribute("VehicleTiresLastPop") ~= initialPop then break end
                    task.wait()
                end
                pcall(sethiddenproperty, root, "PhysicsRepRootPart", root)
            end
            SetState("LeavingVehicle")

        elseif currentState == "LeavingVehicle" then
            if LocalPlayer.Character:GetAttribute("InVehicle") or hum.SeatPart ~= nil then
                hum.Sit = false
                hum.Jump = true
                task.wait(0.5)
            end
            SetState("EquippingHandcuffs")

        elseif currentState == "EquippingHandcuffs" then
            EquipHandcuffs()
            SetState("EjectingTarget")

        elseif currentState == "EjectingTarget" then
            if not IsTargetValid(currentTarget) then
                SetState("FindingTarget")
                continue
            end
            
            local tChar = currentTarget.Character
            local start = tick()
            while CheckGen(gen) and tChar:GetAttribute("InVehicle") and tick() - start < Config.ArrestTimeout do
                EjectTarget(currentTarget, gen)
                task.wait(0.5)
            end
            SetState("ArrestingTarget")

        elseif currentState == "ArrestingTarget" then
            if not IsTargetValid(currentTarget) then
                SetState("FindingTarget")
                continue
            end
            
            local tChar = currentTarget.Character
            if not tChar:GetAttribute("InVehicle") and attemptArrest then
                EquipHandcuffs()
                pcall(attemptArrest, currentTarget)
            end
            SetState("ConfirmingArrest")

        elseif currentState == "ConfirmingArrest" then
            local tChar = currentTarget and currentTarget.Character
            if tChar then
                local start = tick()
                while CheckGen(gen) and tick() - start < Config.ArrestTimeout do
                    if tChar:GetAttribute("HasHandcuffs") then
                        arrestedBlacklist[currentTarget] = true
                        break
                    end
                    pcall(attemptArrest, currentTarget)
                    task.wait(0.5)
                end
            end
            currentTarget = nil
            SetState("ReturningToVehicle")

        elseif currentState == "ReturningToVehicle" then
            if lastExitedVehicle and lastExitedVehicle.Parent then
                local seat = lastExitedVehicle:FindFirstChild("Seat") or lastExitedVehicle:FindFirstChild("VehicleSeat")
                if seat and not seat.Occupant and (seat.Position - root.Position).Magnitude < Config.FarVehicleDistance then
                    local bg, bv = CreateFlight(root)
                    
                    local targetY = root.Position.Y + Config.ReturnVehicleAscendHeight
                    bv.Velocity = Vector3.new(0, Config.AscendSpeed, 0)
                    bg.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(1,0,0))
                    
                    while root.Position.Y < targetY and CheckGen(gen) do task.wait() end
                    
                    local start = tick()
                    while CheckGen(gen) do
                        local toSeat = (seat.Position * Vector3.new(1,0,1)) + Vector3.new(0, targetY, 0)
                        local dir = toSeat - root.Position
                        if dir.Magnitude < 5 or tick() - start > 15 then break end
                        bv.Velocity = dir.Unit * Config.HorizontalSpeed
                        bg.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
                        task.wait()
                    end
                    
                    bv.Velocity = Vector3.new(0, -Config.DescendSpeed, 0)
                    while (root.Position.Y - seat.Position.Y) > 5 and CheckGen(gen) do task.wait() end
                    
                    CleanupPhysics(root)
                    
                    if EnterNearestVehicle(lastExitedVehicle, gen) then
                        SetState("Ascending")
                        continue
                    end
                end
            end
            SetState("SpawningVehicle")

        elseif currentState == "SpawningVehicle" then
            local bg, bv = CreateFlight(root)
            local targetY = root.Position.Y + Config.ReturnVehicleAscendHeight
            bv.Velocity = Vector3.new(0, Config.AscendSpeed, 0)
            bg.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(1,0,0))
            while root.Position.Y < targetY and CheckGen(gen) do task.wait() end
            
            local escapeDir = root.CFrame.LookVector * Config.CamaroSpawnOffset
            local targetPos = root.Position + escapeDir
            local start = tick()
            while CheckGen(gen) and tick() - start < 10 do
                local dir = (targetPos - root.Position) * Vector3.new(1,0,1)
                if dir.Magnitude < 5 then break end
                bv.Velocity = dir.Unit * Config.HorizontalSpeed
                task.wait()
            end
            
            bv.Velocity = Vector3.new(0, -Config.DescendSpeed, 0)
            while CheckGen(gen) do
                if CheckObstacle(root, Vector3.new(0,-1,0), 3) then break end
                task.wait()
            end
            
            CleanupPhysics(root)
            
            local spawnRemote = ReplicatedStorage:FindFirstChild("GarageSpawnVehicle", true)
            if spawnRemote then
                spawnRemote:FireServer("Chassis", "Camaro")
                task.wait(2)
                
                local vehiclesDir = Workspace:FindFirstChild("Vehicles")
                if vehiclesDir then
                    for _, v in pairs(vehiclesDir:GetChildren()) do
                        if v.Name:lower():find("camaro") then
                            local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat")
                            if seat and (seat.Position - root.Position).Magnitude < 30 and not seat.Occupant then
                                if EnterNearestVehicle(v, gen) then
                                    SetState("Ascending")
                                    break
                                end
                            end
                        end
                    end
                end
            end
            
            if currentState == "SpawningVehicle" then
                SetState("FindingVehicle")
            end
            
        elseif currentState == "Respawning" then
            task.wait(1)
        else
            task.wait(0.1)
        end
    end
end

local function OnCharacterAdded(char)
    automationGeneration = automationGeneration + 1
    local currentGen = automationGeneration
    
    local root = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    
    if root and hum then
        CleanupPhysics(root)
        SetState("Initializing")
        task.spawn(AutomationCycle, currentGen)
    end
end

LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
if LocalPlayer.Character then
    task.spawn(OnCharacterAdded, LocalPlayer.Character)
end
