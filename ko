local function monitor(p)
	local function char(c)
		c:GetAttributeChangedSignal("HasHandcuffs"):Connect(function()
			if c:GetAttribute("HasHandcuffs") then arrestedBlacklist[p] = true end
		end)
	end
	if p.Character then char(p.Character) end
	p.CharacterAdded:Connect(char)
end
for _, p in ipairs(Players:GetPlayers()) do monitor(p) end
Players.PlayerAdded:Connect(monitor)

task.spawn(function()
	while task.wait(0.5) do
		local ok, m = pcall(Modules.Vehicle.GetLocalVehicleModel)
		if ok and m and m ~= "" and m ~= false then
			local car = typeof(m) == "Instance" and m or workspace:FindFirstChild(m, true)
			if car and rememberedCar ~= car then rememberedCar = car end
		end
	end
end)

local function checkObstacle(root, dirVector)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {lp.Character, workspace:FindFirstChild("Vehicles")}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local result = workspace:Raycast(root.Position, dirVector, params)
	if result and result.Distance < 5 then
		local hum = lp.Character:FindFirstChild("Humanoid")
		if hum then hum.Health = 0 end
	end
end

local function EquipHandcuffs()
	local invSys = require(RS.Inventory.InventoryItemSystem)
	for _, item in pairs(invSys.getInventoryItemsFor(lp)) do
		if item.obj and item.obj.Name == "Handcuffs" then
			pcall(function() item:AttemptSetEquipped(true) end)
			return true
		end
	end
	return false
end

local function EjectNearestVehicleUser()
	local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local vehicles = workspace:FindFirstChild("Vehicles")
	if not hrp or not vehicles then return end
	local nearest, minDist = nil, 25
	for _, v in pairs(vehicles:GetChildren()) do
		local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
		if seat then
			local d = (hrp.Position - seat.Position).Magnitude
			if d < minDist then minDist, nearest = d, v end
		end
	end
	if not nearest then return end
	if Modules.UI and Modules.UI.CircleAction and Modules.UI.CircleAction.Specs then
		for _, spec in pairs(Modules.UI.CircleAction.Specs) do
			if (spec.Part and (nearest:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(nearest))) or (spec.Text and (spec.Text:lower():find("eject") or spec.Text:lower():find("passenger"))) then
				pcall(function() spec:Callback(true) end)
				return
			end
		end
	end
end

local function isTargetValid(root)
	if not root or not root.Parent then return false end
	local plr = Players:GetPlayerFromCharacter(root.Parent)
	if not plr or arrestedBlacklist[plr] then return false end
	if plr.Team and plr.Team.Name == "Criminal" then
		if plr.Character:GetAttribute("InVehicle") then
			local vehiclesDir = workspace:FindFirstChild("Vehicles")
			if vehiclesDir then
				for _, v in pairs(vehiclesDir:GetChildren()) do
					local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
					if seat and (seat.Position - root.Position).Magnitude < 15 then
						local vName = v.Name:lower()
						if vName:find("heli") or vName:find("drone") or vName:find("blimp") then return false end
					end
				end
			end
		end
		return true
	end
	return false
end

local function getClosestCriminal(p_root)
	local bestRoot, bestDist = nil, math.huge
	local selectedPlr
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character and not arrestedBlacklist[plr] then
			if plr.Team and plr.Team.Name == "Criminal" then
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				if root and isTargetValid(root) then
					local d = (root.Position - p_root.Position).Magnitude
					if d < bestDist then
						bestDist = d
						bestRoot = root
						selectedPlr = plr
					end
				end
			end
		end
	end
	return selectedPlr, bestRoot
end

local function escapeBuilding(rootPart)
	local closestPath, minDist = nil, math.huge
	for _, data in pairs(PoliceData) do
		local dist = (rootPart.Position - data.Base).Magnitude
		if dist < minDist then minDist = dist; closestPath = data.Path end
	end
	if minDist < 100 and closestPath then
		for _, wp in ipairs(closestPath) do
			if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
				lp.Character.HumanoidRootPart.CFrame = CFrame.new(wp)
				task.wait(0.2)
			end
		end
	end
end

local function enterTargetVehicle(vehicle)
	local seat = vehicle:FindFirstChild("Seat") or vehicle:FindFirstChild("VehicleSeat")
	if not seat then return end
	if Modules.UI and Modules.UI.CircleAction and Modules.UI.CircleAction.Specs then
		for _, spec in pairs(Modules.UI.CircleAction.Specs) do
			if spec.Part and spec.Part == seat then
				pcall(function() spec:Callback(true) end)
				break
			end
		end
	end
end

local function spawnAndEnterCamaro(rootPart)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {lp.Character, workspace:FindFirstChild("Vehicles")}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local result = workspace:Raycast(rootPart.Position, Vector3.new(0, -9999, 0), params)
	if result then rootPart.CFrame = CFrame.new(result.Position + Vector3.new(0, 5, 0)) end
	task.wait(0.5)
	local spawnRemote = RS:FindFirstChild("GarageSpawnVehicle", true)
	if spawnRemote then spawnRemote:FireServer("Chassis", "Camaro") end
	task.wait(1)
	if rememberedCar then enterTargetVehicle(rememberedCar) end
end

local function flyToVehicleTarget(rootPart, targetPos)
	local BodyGyro = Instance.new("BodyGyro", rootPart)
	local BodyVelocity = Instance.new("BodyVelocity", rootPart)
	BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	BodyGyro.D = 500; BodyGyro.P = 150000
	local reachedHoriz = false
	while getgenv().AutoArrestActive and lp.Character and lp.Character:FindFirstChild("Humanoid") and lp.Character.Humanoid.Health > 0 do
		local flatTarget = Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z)
		if not reachedHoriz and (flatTarget - rootPart.Position).Magnitude > 1 then
			BodyGyro.CFrame = CFrame.lookAt(rootPart.Position, flatTarget)
		else
			BodyGyro.CFrame = CFrame.new(rootPart.Position, rootPart.Position + Vector3.new(0, 0, -1))
		end
		local hDist = (flatTarget - rootPart.Position).Magnitude
		if not reachedHoriz then
			if hDist > 10 then
				BodyVelocity.Velocity = (flatTarget - rootPart.Position).Unit * Config.CarAscendSpeed
			else
				reachedHoriz = true
			end
		else
			local vDist = (targetPos - rootPart.Position).Magnitude
			if vDist > 15 then
				BodyVelocity.Velocity = (targetPos - rootPart.Position).Unit * Config.CarAscendSpeed
				checkObstacle(rootPart, Vector3.new(0, -5, 0))
			else
				break
			end
		end
		task.wait()
	end
	BodyVelocity:Destroy(); BodyGyro:Destroy()
end

task.spawn(function()
	while getgenv().AutoArrestActive do
		task.wait(0.1)
		local char = lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChild("Humanoid")
		if not root or not hum or hum.Health <= 0 then continue end

		escapeBuilding(root)
		local inVehicle = char:GetAttribute("InVehicle") or (hum.SeatPart ~= nil)

		if not inVehicle then
			local vDir = workspace:FindFirstChild("Vehicles")
			local nCar, nDist = nil, math.huge
			if vDir then
				for _, v in pairs(vDir:GetChildren()) do
					local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat")
					if seat then
						local d = (root.Position - seat.Position).Magnitude
						if d < nDist then nDist = d; nCar = v end
					end
				end
			end
			if nCar and nDist < 200 then
				flyToVehicleTarget(root, nCar.PrimaryPart and nCar.PrimaryPart.Position or nCar:GetModelCFrame().Position)
				enterTargetVehicle(nCar)
			else
				spawnAndEnterCamaro(root)
			end
			task.wait(1)
			inVehicle = char:GetAttribute("InVehicle") or (hum.SeatPart ~= nil)
		end

		if inVehicle then
			local BodyGyro = Instance.new("BodyGyro", root)
			local BodyVelocity = Instance.new("BodyVelocity", root)
			BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			BodyGyro.D = 500; BodyGyro.P = 150000

			-- STEP 1: FLY UPWARD 500 STUDS
			local targetY = root.Position.Y + Config.CarFlyHeight
			while getgenv().AutoArrestActive and hum.Health > 0 and root.Position.Y < targetY do
				BodyVelocity.Velocity = Vector3.new(0, Config.CarAscendSpeed, 0)
				BodyGyro.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(0, 0, -1))
				checkObstacle(root, Vector3.new(0, 5, 0))
				task.wait()
			end

			-- STEP 2: HOVER AND FIND CLOSEST TARGET
			local targetPlr, targetRoot
			while getgenv().AutoArrestActive and hum.Health > 0 do
				targetPlr, targetRoot = getClosestCriminal(root)
				if targetRoot then
					break
				end
				BodyVelocity.Velocity = Vector3.zero
				BodyGyro.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(0, 0, -1))
				task.wait()
			end

			-- STEP 3: CRUISE UNTIL DIRECTLY ABOVE THE TARGET, THEN GO DOWNWARD UNTIL 15 STUDS
			if targetRoot then
				local reachedAbove = false
				while getgenv().AutoArrestActive and hum.Health > 0 and isTargetValid(targetRoot) do
					local flatDist = Vector2.new(targetRoot.Position.X - root.Position.X, targetRoot.Position.Z - root.Position.Z).Magnitude

					if not reachedAbove then
						if flatDist > 15 then
							local targetPosH = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
							local dir = (targetPosH - root.Position).Unit
							BodyVelocity.Velocity = dir * Config.CarAscendSpeed
							BodyGyro.CFrame = CFrame.lookAt(root.Position, targetPosH)
						else
							reachedAbove = true 
						end
					else
						local distToTarget = (targetRoot.Position - root.Position).Magnitude
						if distToTarget > 15 then
							local dir = (targetRoot.Position - root.Position).Unit
							BodyVelocity.Velocity = dir * Config.CarAscendSpeed
							BodyGyro.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(0, 0, -1))
						else
							break -- 15 studs close, stop moving down and begin tire-popping loop
						end
					end
					task.wait()
				end

				-- STEP 4: TIRE POPPING LOOP (TELEPORTING WHILE MAINTAINING VEHICLE)
				local tChar = targetRoot.Parent
				local targetVehicle = tChar and tChar:GetAttribute("InVehicle") and tChar.Humanoid.SeatPart and tChar.Humanoid.SeatPart.Parent

				if targetVehicle then
					local initialPop = targetVehicle:GetAttribute("VehicleTiresLastPop")
					local rStart = tick()
					
					while getgenv().AutoArrestActive and isTargetValid(targetRoot) and (tick() - rStart < Config.CarMaxRamDuration) do
						pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", targetRoot) end)
						root.CFrame = targetRoot.CFrame * Config.TpOffset
						BodyVelocity.Velocity = Vector3.zero 
						
						local currentPop = targetVehicle:GetAttribute("VehicleTiresLastPop")
						if currentPop ~= initialPop then break end
						task.wait()
					end
				end
			end

			BodyVelocity:Destroy(); BodyGyro:Destroy()

			-- STEP 5: DISMOUNT VEHICLE VIA SPACE KEY
			if char:GetAttribute("InVehicle") then
				vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
				task.wait(0.05)
				vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
				task.wait(0.5) 
			end

			-- STEP 6: FLY TO TARGET AND 10 STUDS BELOW ACTIVATION FOR ARREST
			if targetRoot and isTargetValid(targetRoot) then
				local tChar = targetRoot.Parent
				local BodyGyroFlight = Instance.new("BodyGyro", root)
				local BodyVelocityFlight = Instance.new("BodyVelocity", root)
				BodyVelocityFlight.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				BodyGyroFlight.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
				BodyGyroFlight.D = 500; BodyGyroFlight.P = 150000

				while getgenv().AutoArrestActive and isTargetValid(targetRoot) and not tChar:GetAttribute("HasHandcuffs") do
					local dist = (targetRoot.Position - root.Position).Magnitude
					if dist > 10 then
						BodyVelocityFlight.Velocity = (targetRoot.Position - root.Position).Unit * Config.CarAscendSpeed
						BodyGyroFlight.CFrame = CFrame.lookAt(root.Position, targetRoot.Position)
						task.wait()
					else
						-- Close enough (under 10 studs), break out of flight and start looping sethiddenproperty
						break
					end
				end
				BodyVelocityFlight:Destroy(); BodyGyroFlight:Destroy()

				EquipHandcuffs()
				local attempts = 0
				
				while getgenv().AutoArrestActive and isTargetValid(targetRoot) and not tChar:GetAttribute("HasHandcuffs") and attempts < 25 do
					pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", targetRoot) end)
					root.CFrame = targetRoot.CFrame * Config.TpOffset
					
					if tChar:GetAttribute("InVehicle") then 
						EjectNearestVehicleUser() 
					else 
						if attemptArrest and targetPlr then 
							pcall(function() attemptArrest(targetPlr) end) 
						end 
					end
					
					attempts = attempts + 1
					task.wait(0.2)
				end
				
				pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", root) end)

				if tChar:GetAttribute("HasHandcuffs") then arrestedBlacklist[targetPlr] = true end
				
				local upPos = root.Position + Vector3.new(0, 50, 0)
				root.CFrame = CFrame.new(upPos)
				task.wait(0.2)
				
				if rememberedCar and rememberedCar.PrimaryPart and (rememberedCar.PrimaryPart.Position - root.Position).Magnitude < 500 then
					flyToVehicleTarget(root, rememberedCar.PrimaryPart.Position)
					enterTargetVehicle(rememberedCar)
				else
					root.CFrame = CFrame.new(root.Position + Vector3.new(300, 0, 0))
					spawnAndEnterCamaro(root)
				end
			end
		end
	end
end)
