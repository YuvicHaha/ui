-- Base Functions
local function EquipHandcuffs()
    for _, item in pairs(Modules.EquipThing.getInventoryItemsFor(LocalPlayer)) do
        if item.obj and item.obj.Name == "Handcuffs" then
            pcall(function() item:AttemptSetEquipped(true) end)
            return true
        end
    end
    return false
end

local function EjectNearestVehicleUser(hrp)
    local vehicles = Workspace:FindFirstChild("Vehicles")
    if not hrp or not vehicles then return end
    
    local nearest, minDist = nil, 25
    for _, v in pairs(vehicles:GetChildren()) do
        local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
        if seat then
            local d = (hrp.Position - seat.Position).Magnitude
            if d < minDist then minDist, nearest = d, v end
        end
    end

    if not nearest then return end

    if Modules.UI and Modules.UI.CircleAction and Modules.UI.CircleAction.Specs then
        for _, spec in pairs(Modules.UI.CircleAction.Specs) do
            local isMatch = false
            if spec.Part and (nearest:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(nearest)) then isMatch = true
            elseif spec.Text and (spec.Text:lower():find("eject") or spec.Text:lower():find("passenger")) then isMatch = true end
            
            if isMatch then
                pcall(function() spec:Callback(true) end)
                print("[SUCCESS] Triggered Eject")
                return
            end
        end
    end
end

local function CheckForObstacle(hrp, direction)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, Workspace.Vehicles}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(hrp.Position, direction, params)
    
    if result then
        warn("[SAFETY] Obstacle detected, resetting character!")
        LocalPlayer.Character:BreakJoints()
        return true
    end
    return false
end

local function SpawnCamaro(hrp)
    local spawnRemote = ReplicatedStorage:FindFirstChild("GarageSpawnVehicle", true)
    if spawnRemote then
        -- Teleport safely away first on ground
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -300)
        task.wait(0.5)
        spawnRemote:FireServer("Chassis", "Camaro")
        print("[SUCCESS] Camaro spawned!")
    end
end

-- Teleport Outside
local function TeleportOutsideBuilding(hrp)
    for name, data in pairs(PoliceData) do
        if (hrp.Position - data.Base).Magnitude < 100 then
            print("[PATH] Exiting building via:", name)
            for _, point in ipairs(data.Path) do
                if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
                hrp.CFrame = CFrame.new(point)
                task.wait(0.1)
            end
            break
        end
    end
end

-- Find Valid Target
local function GetClosestCriminal(hrp)
    local target, minDist = nil, math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and not arrestedBlacklist[plr] then
            if plr.Team and (plr.Team.Name == "Criminal" or plr.Team.Name == "Prisoner") then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    -- Detect if they are in Blacklisted Vehicle types
                    local validTarget = true
                    if plr.Character:GetAttribute("InVehicle") then
                        local vehiclesDir = Workspace:FindFirstChild("Vehicles")
                        if vehiclesDir then
                            for _, v in pairs(vehiclesDir:GetChildren()) do
                                local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
                                if seat and (seat.Position - root.Position).Magnitude < 15 then
                                    local vName = v.Name:lower()
                                    if vName:find("heli") or vName:find("drone") or vName:find("blimp") then
                                        validTarget = false
                                    end
                                end
                            end
                        end
                    end
                    
                    if validTarget then
                        local d = (root.Position - hrp.Position).Magnitude
                        if d < minDist then minDist, target = d, plr end
                    end
                end
            end
        end
    end
    return target, minDist
end

-- Main Execution Thread
task.spawn(function()
    while getgenv().AutoArrestActive do
        task.wait(0.1)
        
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        if not char or not hrp or not humanoid or humanoid.Health <= 0 then continue end
        
        -- 1. Escape Station
        TeleportOutsideBuilding(hrp)
        
        local BodyGyro = hrp:FindFirstChild("AutoArrestGyro") or Instance.new("BodyGyro", hrp)
        local BodyVelocity = hrp:FindFirstChild("AutoArrestVelocity") or Instance.new("BodyVelocity", hrp)
        BodyGyro.Name = "AutoArrestGyro"
        BodyVelocity.Name = "AutoArrestVelocity"
        BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        BodyGyro.D = 500
        BodyGyro.P = 150000

        local inCar = char:GetAttribute("InVehicle") or humanoid.SeatPart ~= nil
        
        -- 2. Find and Enter Vehicle if NOT in one
        if not inCar then
            if CheckForObstacle(hrp, Vector3.new(0, 100, 0)) then continue end
            
            -- Go UP 100 studs first
            BodyVelocity.Velocity = Vector3.new(0, Config.CarAscendSpeed, 0)
            BodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(0, 0, -1))
            task.wait(2)
            
            local myCar = getgenv().GetMyCar()
            
            if myCar and myCar:FindFirstChild("Seat") and (myCar.Seat.Position - hrp.Position).Magnitude > 500 then
                SpawnCamaro(hrp)
                task.wait(2)
            elseif myCar and myCar:FindFirstChild("Seat") then
                -- Fly horizontally, then down
                local tPos = myCar.Seat.Position + Vector3.new(0, 50, 0)
                BodyVelocity.Velocity = (tPos - hrp.Position).Unit * 100
                BodyGyro.CFrame = CFrame.new(hrp.Position, tPos)
                task.wait(1)
                
                BodyVelocity.Velocity = Vector3.new(0, -Config.CarAscendSpeed, 0)
                task.wait(1)
                
                -- Attempt to enter
                for _, spec in pairs(Modules.UI.CircleAction.Specs) do
                    if spec.Part and spec.Part == myCar.Seat then spec:Callback(true) break end
                end
            end
            
            local start = tick()
            while tick() - start < Config.VehicleTimeout do
                if char:GetAttribute("InVehicle") then inCar = true break end
                task.wait(0.1)
            end
            
            if not inCar then SpawnCamaro(hrp) end
            continue 
        end
        
        -- 3. Fly Upward 500 Studs (in vehicle)
        if hrp.Position.Y < Config.CarFlyHeight then
            if CheckForObstacle(hrp, Vector3.new(0, Config.CarFlyHeight, 0)) then continue end
            BodyVelocity.Velocity = Vector3.new(0, Config.CarAscendSpeed, 0)
            BodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + hrp.CFrame.LookVector)
            task.wait(0.5)
            continue
        end
        
        -- 4. Find Nearest Target and Cruise
        local target, dist = GetClosestCriminal(hrp)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local tRoot = target.Character.HumanoidRootPart
            
            -- Cruise to Target (Horizontally then down)
            local offsetHeight = (dist < 50) and 0 or 50 
            local targetPos = tRoot.Position + Vector3.new(0, offsetHeight, 0)
            
            BodyVelocity.Velocity = (targetPos - hrp.Position).Unit * 150
            BodyGyro.CFrame = CFrame.new(hrp.Position, tRoot.Position)
            
            -- 5. Close enough (20 studs) -> Pop Tires / Eject / Arrest
            if (hrp.Position - tRoot.Position).Magnitude < 20 then
                BodyVelocity.Velocity = Vector3.zero
                
                local targetVehicle = target.Character:GetAttribute("InVehicle") and target.Character.Humanoid.SeatPart and target.Character.Humanoid.SeatPart.Parent
                
                if targetVehicle then
                    -- Pop Tires Sequence
                    local initialPop = targetVehicle:GetAttribute("VehicleTiresLastPop")
                    local rStart = tick()
                    
                    while getgenv().AutoArrestActive and (tick() - rStart < Config.CarMaxRamDuration) do
                        pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", tRoot) end)
                        hrp.CFrame = tRoot.CFrame * Config.TpOffset
                        if targetVehicle:GetAttribute("VehicleTiresLastPop") ~= initialPop then break end
                        task.wait(0.1)
                    end
                end
                
                -- Unmount and Arrest
                if char:GetAttribute("InVehicle") then 
                    -- Emulate jumping out
                    humanoid.Jump = true 
                    task.wait(0.2)
                end
                
                pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", tRoot) end)
                hrp.CFrame = tRoot.CFrame * Config.TpOffset
                EquipHandcuffs()
                
                if target.Character:GetAttribute("InVehicle") then
                    EjectNearestVehicleUser(hrp)
                else
                    if attemptArrest then pcall(function() attemptArrest(target) end) end
                end
                
                task.wait(0.5)
            end
        else
            -- Hover if no targets
            BodyVelocity.Velocity = Vector3.zero
            BodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + hrp.CFrame.LookVector)
        end
    end
end)
