-- Extract Arrest Function via Garbage Collection
local attemptArrest
for _, v in pairs(getgc(true)) do
    if type(v) == "function" and islclosure(v) then
        pcall(function()
            if tostring(getinfo(v).name) == "AttemptArrest" then attemptArrest = v end
        end)
        if attemptArrest then break end
    end
end

