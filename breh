local arrestedBlacklist = {}
local sessionToken = 0
local rememberedCar = nil
local attemptArrest = nil
local activeFlightMovers = {}

for _, v in pairs(getgc(true)) do
    if type(v) == "function" and islclosure(v) then
        pcall(function()
            if tostring(getinfo(v).name) == "AttemptArrest" then
                attemptArrest = v
            end
        end)
        if attemptArrest then break end
    end
end

local function EquipHandcuffs()
    pcall(function()
        local invSys = require(ReplicatedStorage.Inventory.InventoryItemSystem)
        for _, item in pairs(invSys.getInventoryItemsFor(LocalPlayer)) do
            if item.obj and item.obj.Name == "Handcuffs" then
                item:AttemptSetEquipped(true)
            end
        end
    end)
end

local function MonitorHandcuffs()
    local function hookChar(c, p)
        c:GetAttributeChangedSignal("HasHandcuffs"):Connect(function()
            if c:GetAttribute("HasHandcuffs") then
                arrestedBlacklist[p] = true
            end
        end)
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then hookChar(p.Character, p) end
        p.CharacterAdded:Connect(function(c) hookChar(c, p) end)
    end
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function(c) hookChar(c, p) end)
    end)
end
task.spawn(MonitorHandcuffs)

local function IsSessionValid(token)
    if not getgenv().AutoArrestActive then return false end
    if sessionToken ~= token then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return false end
    return true, char, hum, root
end

local function CleanUpFlight()
    for _, obj in ipairs(activeFlightMovers) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(activeFlightMovers)
    Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
end

local function AbortSession(token)
    if sessionToken == token then
        sessionToken = sessionToken + 1
        CleanUpFlight()
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
        end
    end
end

local function GetTargetVehicle(targetChar)
    if not targetChar or not targetChar:GetAttribute("InVehicle") then return nil end
    local root = targetChar:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local vehicles = Workspace:FindFirstChild("Vehicles")
    if not vehicles then return nil end
    local nearest, minDist = nil, 25
    for _, v in pairs(vehicles:GetChildren()) do
        local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart", true)
        if seat then
            local d = (root.Position - seat.Position).Magnitude
            if d < minDist then
                minDist = d
                nearest = v
            end
        end
    end
    return nearest
end

local function IsAircraft(vehicle)
    if not vehicle then return false end
    local name = vehicle.Name:lower()
    for _, kw in ipairs(Config.AircraftKeywords) do
        if string.find(name, kw) then return true end
    end
    return false
end

local function IsTargetValid(plr)
    if plr == LocalPlayer then return false end
    if arrestedBlacklist[plr] then return false end
    if not plr.Team or plr.Team.Name ~= "Criminal" then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return false end
    local veh = GetTargetVehicle(char)
    if veh and IsAircraft(veh) then return false end
    return true, root, char
end

local function FindVehicle(token, rootPos)
    local vehicles = Workspace:FindFirstChild("Vehicles")
    if not vehicles then return nil end
    local nearest, minDist, targetSeat = nil, Config.InteractionDistance, nil
    for _, v in pairs(vehicles:GetChildren()) do
        local seat = v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat")
        if seat and not seat.Occupant then
            local d = (rootPos - seat.Position).Magnitude
            if d < minDist then
                minDist = d
                nearest = v
                targetSeat = seat
            end
        end
    end
    return nearest, targetSeat
end

local function EjectSpecificVehicle(token, targetVeh)
    if not targetVeh then return false end
    local uiModule = ReplicatedStorage:FindFirstChild("Module", true) and require(ReplicatedStorage.Module:FindFirstChild("UI", true) or ReplicatedStorage.Module)
    if uiModule and uiModule.CircleAction and uiModule.CircleAction.Specs then
        for _, spec in pairs(uiModule.CircleAction.Specs) do
            local isMatch = false
            if spec.Part and (targetVeh:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(targetVeh)) then
                isMatch = true
            elseif spec.Text then
                local text = spec.Text:lower()
                if text:find("eject") or text:find("passenger") then isMatch = true end
            end
            if isMatch then
                pcall(function() spec:Callback(true) end)
                return true
            end
        end
    end
    return false
end

local function EnterVehicle(token, seat)
    local uiModule = ReplicatedStorage:FindFirstChild("Module", true) and require(ReplicatedStorage.Module:FindFirstChild("UI", true) or ReplicatedStorage.Module)
    if uiModule and uiModule.CircleAction and uiModule.CircleAction.Specs then
        for _, spec in pairs(uiModule.CircleAction.Specs) do
            if spec.Part and spec.Part == seat then
                pcall(function() spec:Callback(true) end)
                return true
            end
        end
    end
    return false
end

local function SpawnCamaro(token)
    local spawnRemote = ReplicatedStorage:FindFirstChild("GarageSpawnVehicle", true)
    if spawnRemote then
        pcall(function() spawnRemote:FireServer("Chassis", "Camaro") end)
    end
    task.wait(1)
end

local function RaycastObstacle(startPos, direction, ignoreList)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = ignoreList
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(startPos, direction, params)
    return result ~= nil
end

local function ControlledFlight(token, targetPos, requireHorizontalOnly, stopDist)
    local valid, char, hum, root = IsSessionValid(token)
    if not valid then return false end

    CleanUpFlight()
    local bg = Instance.new("BodyGyro")
    local bv = Instance.new("BodyVelocity")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.D = Config.FlightResponsivenessD
    bg.P = Config.FlightResponsivenessP
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bg.Parent = root
    bv.Parent = root
    table.insert(activeFlightMovers, bg)
    table.insert(activeFlightMovers, bv)

    Workspace.CurrentCamera.CameraType = Enum.CameraType.Track

    local success = true
    while true do
        valid, char, hum, root = IsSessionValid(token)
        if not valid then success = false; break end

        local currentPos = root.Position
        local tPos = requireHorizontalOnly and Vector3.new(targetPos.X, currentPos.Y, targetPos.Z) or targetPos
        local dist = (tPos - currentPos).Magnitude
        
        if dist <= stopDist then break end

        local dir = (tPos - currentPos).Unit
        if RaycastObstacle(currentPos, dir * 15, {char, rememberedCar, Workspace:FindFirstChild("Vehicles")}) then
            success = false
            AbortSession(token)
            break
        end

        bg.CFrame = CFrame.lookAt(currentPos, currentPos + dir)
        bv.Velocity = dir * Config.FlightSpeed
        RunService.Heartbeat:Wait()
    end
    
    CleanUpFlight()
    return success
end

local function RunAutomationSession(token)
    local state = "INITIALIZING"
    local targetPlr = nil
    
    while IsSessionValid(token) do
        local valid, char, hum, root = IsSessionValid(token)
        if not valid then break end

        if state == "INITIALIZING" then
            CleanUpFlight()
            state = "EXITING_BUILDING"
        
        elseif state == "EXITING_BUILDING" then
            local nearestPath, minDist = nil, math.huge
            for name, data in pairs(PoliceData) do
                local dist = (root.Position - data.Base).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearestPath = data.Path
                end
            end
            
            if minDist < 150 and nearestPath then
                for _, wp in ipairs(nearestPath) do
                    if not IsSessionValid(token) then return end
                    root.CFrame = CFrame.new(wp)
                    task.wait(Config.WaypointDelay)
                end
            end
            state = "FINDING_VEHICLE"
            
        elseif state == "FINDING_VEHICLE" then
            local veh, seat = FindVehicle(token, root.Position)
            if veh and seat then
                EnterVehicle(token, seat)
                state = "ENTERING_VEHICLE"
            else
                SpawnCamaro(token)
                local cVeh, cSeat = FindVehicle(token, root.Position)
                if cVeh and cSeat then
                    EnterVehicle(token, cSeat)
                    state = "ENTERING_VEHICLE"
                else
                    task.wait(1)
                end
            end
            
        elseif state == "ENTERING_VEHICLE" then
            local waitStart = tick()
            local entered = false
            while IsSessionValid(token) and (tick() - waitStart < Config.VehicleEntryTimeout) do
                if char:GetAttribute("InVehicle") or hum.SeatPart ~= nil then
                    entered = true
                    rememberedCar = hum.SeatPart and hum.SeatPart.Parent or nil
                    break
                end
                task.wait(0.5)
            end
            if entered then
                state = "ASCENDING"
            else
                state = "FINDING_VEHICLE"
            end
            
        elseif state == "ASCENDING" then
            local targetAscent = root.Position + Vector3.new(0, Config.AscentHeight, 0)
            local flightOk = ControlledFlight(token, targetAscent, false, 5)
            if flightOk then
                state = "SEARCHING_TARGET"
            end
            
        elseif state == "SEARCHING_TARGET" then
            local nearest, mDist = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                local pValid, pRoot = IsTargetValid(p)
                if pValid then
                    local d = (pRoot.Position - root.Position).Magnitude
                    if d < mDist then
                        mDist = d
                        nearest = p
                    end
                end
            end
            if nearest then
                targetPlr = nearest
                state = "APPROACHING_TARGET"
            else
                task.wait(1)
            end
            
        elseif state == "APPROACHING_TARGET" then
            local tValid, tRoot, tChar = IsTargetValid(targetPlr)
            if not tValid then
                state = "SEARCHING_TARGET"
                continue
            end
            
            -- Horizontal approach
            if ControlledFlight(token, tRoot.Position, true, 10) then
                -- Vertical approach
                local descValid = ControlledFlight(token, tRoot.Position + Config.TargetOffset.Position, false, Config.EngagementDistance)
                if descValid then
                    if tChar:GetAttribute("InVehicle") then
                        state = "TIRE_POP"
                    else
                        state = "ARRESTING_TARGET"
                    end
                end
            end
            
        elseif state == "TIRE_POP" then
            local tValid, tRoot, tChar = IsTargetValid(targetPlr)
            if not tValid then state = "SEARCHING_TARGET"; continue end
            
            local tVeh = GetTargetVehicle(tChar)
            if tVeh then
                local initialPop = tVeh:GetAttribute("VehicleTiresLastPop")
                local pStart = tick()
                
                local bg = Instance.new("BodyGyro", root)
                local bv = Instance.new("BodyVelocity", root)
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                table.insert(activeFlightMovers, bg)
                table.insert(activeFlightMovers, bv)
                
                while IsSessionValid(token) and (tick() - pStart < Config.CarMaxRamDuration) do
                    local curValid, curRoot = IsTargetValid(targetPlr)
                    if not curValid then break end
                    if not tChar:GetAttribute("InVehicle") then break end
                    if tVeh:GetAttribute("VehicleTiresLastPop") ~= initialPop then break end
                    
                    pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", curRoot) end)
                    root.CFrame = curRoot.CFrame * Config.TpOffset
                    bv.Velocity = Vector3.zero
                    RunService.Heartbeat:Wait()
                end
                
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
                CleanUpFlight()
                state = "EJECTING_TARGET"
            else
                state = "ARRESTING_TARGET"
            end
            
        elseif state == "EJECTING_TARGET" then
            local tValid, tRoot, tChar = IsTargetValid(targetPlr)
            if not tValid then state = "SEARCHING_TARGET"; continue end
            
            if tChar:GetAttribute("InVehicle") then
                if hum.SeatPart then hum.Sit = false; task.wait(0.2) end
                local tVeh = GetTargetVehicle(tChar)
                EjectSpecificVehicle(token, tVeh)
                task.wait(0.5)
            else
                state = "ARRESTING_TARGET"
            end
            
        elseif state == "ARRESTING_TARGET" then
            local tValid, tRoot, tChar = IsTargetValid(targetPlr)
            if not tValid then state = "SEARCHING_TARGET"; continue end
            
            if hum.SeatPart then hum.Sit = false; task.wait(0.2) end
            
            EquipHandcuffs()
            if attemptArrest then
                pcall(function() attemptArrest(targetPlr) end)
            end
            state = "WAITING_FOR_HANDCUFF"
            
        elseif state == "WAITING_FOR_HANDCUFF" then
            local wStart = tick()
            local arrested = false
            while IsSessionValid(token) and (tick() - wStart < Config.ArrestTimeout) do
                if targetPlr and targetPlr.Character and targetPlr.Character:GetAttribute("HasHandcuffs") then
                    arrestedBlacklist[targetPlr] = true
                    arrested = true
                    break
                end
                task.wait(0.2)
            end
            targetPlr = nil
            state = "RETURNING_TO_VEHICLE"
            
        elseif state == "RETURNING_TO_VEHICLE" then
            local vPos = rememberedCar and rememberedCar:FindFirstChild("Seat") and rememberedCar.Seat.Position
            if vPos and (root.Position - vPos).Magnitude <= Config.MaxRememberedDistance then
                ControlledFlight(token, root.Position + Vector3.new(0, Config.ReturnAltitude, 0), false, 5)
                ControlledFlight(token, vPos, true, 5)
                ControlledFlight(token, vPos, false, Config.InteractionDistance)
                state = "FINDING_VEHICLE"
            else
                local safeSpot = root.CFrame * CFrame.new(0, 0, Config.SpawnDisplacement)
                ControlledFlight(token, root.Position + Vector3.new(0, Config.ReturnAltitude, 0), false, 5)
                ControlledFlight(token, safeSpot.Position, true, 10)
                ControlledFlight(token, safeSpot.Position - Vector3.new(0, Config.ReturnAltitude, 0), false, 5)
                state = "FINDING_VEHICLE"
            end
        end
        task.wait()
    end
end

local function OnCharacterAdded(char)
    sessionToken = sessionToken + 1
    local token = sessionToken
    
    local hum = char:WaitForChild("Humanoid", 10)
    local root = char:WaitForChild("HumanoidRootPart", 10)
    
    if hum and root then
        hum.Died:Connect(function() AbortSession(token) end)
        task.spawn(RunAutomationSession, token)
    end
end

if LocalPlayer.Character then
    task.spawn(OnCharacterAdded, LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
