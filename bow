local function IsObstacleAboveSession(root,distance,vehicle,g)
    if not validGeneration(g) or not root or not root.Parent then return true end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local ignore={root.Parent}
    if vehicle and vehicle.Parent then ignore[#ignore+1]=vehicle end
    params.FilterDescendantsInstances=ignore
    params.IgnoreWater=true
    local hit=workspace:Raycast(root.Position,Vector3.new(0,distance or Config.CeilingCheckRayDistance,0),params)
    return hit~=nil and hit.Instance and hit.Instance.CanCollide==true
end

