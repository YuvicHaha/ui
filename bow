    if not seat then return true end
    if seat.Occupant and seat.Occupant~=humanoid then return true end
    local driver=car:FindFirstChild("Driver",true)
    if driver and driver:IsA("ObjectValue") and driver.Value and driver.Value~=LocalPlayer then return true end
    return false
end

