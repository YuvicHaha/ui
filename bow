RunPhase1=function(g)
    if phase1Running or not validGeneration(g) then return end
    phase1Running=true
    phase1Active=true
    phase1Complete=false
    phase="PHASE_1"
    local char,hum,root=getCharacter()
    if not char or not hum or not root then phase1Running=false; return end
    local closestStation=nil
    local minBaseDist=math.huge
    for _,data in pairs(PoliceData) do
        local dist=(root.Position-data.Base).Magnitude
        if dist<minBaseDist then minBaseDist=dist; closestStation=data end
    end
    if not closestStation then phase1Running=false; return end
    if not beginMovement(g,"PHASE_1") then phase1Running=false; return end
    antiStuckBegin(g,"PHASE_1",root)
    for _,waypoint in ipairs(closestStation.Path) do
        if not validGeneration(g) or phase~="PHASE_1" then endMovement("PHASE_1"); phase1Running=false; return end
        char,hum,root=getCharacter()
        if not char or not hum or not root then endMovement("PHASE_1"); phase1Running=false; return end
        root.CFrame=CFrame.new(waypoint)
        local ok=waitProximity(g,root,waypoint,6,2,"PHASE_1")
        if not ok and validGeneration(g) then
            root.CFrame=CFrame.new(waypoint)
        end
        if antiStuckCheck(g,"PHASE_1",root) then phase1Running=false; return end
        task.wait(Config.WaypointDelay)
    end
    char,hum,root=getCharacter()
    if not char or not hum or not root then endMovement("PHASE_1"); phase1Running=false; return end
    phase1FinalPosition=root.Position
    phase1Active=false
    phase1Complete=true
    phase="PHASE_1_FINAL_WAIT"
    endMovement("PHASE_1")
    local final=phase1FinalPosition
    local start=tick()
    while validGeneration(g) and tick()-start<Config.Phase1FinalWait do
        char,hum,root=getCharacter()
        if not char or not hum or not root then phase1Running=false; return end
        if (root.Position-final).Magnitude>30 then
            requestReset("PHASE 1 FINAL LAGBACK")
            phase1Running=false
            return
        end
        task.wait(0.05)
    end
    if not validGeneration(g) then phase1Running=false; return end
    char,hum,root=getCharacter()
    if not char or not hum or not root or (root.Position-final).Magnitude>30 then
        requestReset("PHASE 1 FINAL POSITION INVALID")
        phase1Running=false
        return
    end
    phase1Running=false
    if not selectAndEnterPhase1Vehicle(g) then return end
end

local function createSessionNow()
    if ServerHopActive then return end
    local char,hum,root=getCharacter()
    if not char or not hum or not root then return end
    local g=newGeneration()
    sessionConnections[#sessionConnections+1]=hum.Died:Connect(function() handleDeathOrRemoval("HUMANOID DIED") end)
    task.spawn(function()
        if not validGeneration(g) then return end
        RunPhase1(g)
        if not validGeneration(g) then return end
        if phase=="TARGET_FOLLOW" then
            task.spawn(function() monitorDismount(g) end)
            targetFollow(g)
        end
    end)
end

local function startSessionAfterRespawn()
    if resetInProgress then resetInProgress=false end
    if ServerHopActive then return end
    local char,hum,root=getCharacter()
    if not char or not hum or not root then return end
    waitExactRespawnSecond()
    if LocalPlayer.Character~=char then return end
    createSessionNow()
end

handleDeathOrRemoval=function(reason,removedCharacter)
    if resetInProgress then return end
    resetInProgress=true
    invalidateGeneration()
    StopAllAutomation()
    currentTarget=nil
    targetRoot=nil
    targetVehicle=nil
    selectedVehicle=nil
    phase="WAITING_FOR_RESPAWN"
    task.spawn(function()
        local deadline=tick()+30
        while tick()<deadline do
            if ServerHopActive then resetInProgress=false; return end
            if removedCharacter and LocalPlayer.Character==removedCharacter then
                task.wait(0.05)
                continue
            end
            local char,hum,root=getCharacter()
            if char and hum and root and (not removedCharacter or char~=removedCharacter) then
                waitExactRespawnSecond()
                if LocalPlayer.Character==char then
                    resetInProgress=false
                    createSessionNow()
                end
                return
            end
            task.wait(0.05)
        end
        resetInProgress=false
    end)
end

-- Local vehicle memory is deliberately independent from targetVehicle/selectedVehicle/lastCarExited.
local rememberedCar
local function IsDriverVehicle(car,char,humanoid)
    if not car or not car.Parent or not char or not humanoid then return false end
    local seat=getVehicleSeat(car)
    if not seat then return false end
    if seat.Occupant==humanoid then return true end
    local driver=car:FindFirstChild("Driver",true)
    return driver and driver:IsA("ObjectValue") and driver.Value==LocalPlayer or false
end

getgenv().GetMyCar=function() return rememberedCar end

task.spawn(function()
    while true do
        task.wait(0.5)
        local char=LocalPlayer.Character
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        local ok,m=pcall(vehicleUtils.GetLocalVehicleModel)
        if ok and m and m~="" and m~=false and char and hum then
            local car=typeof(m)=="Instance" and m or workspace:FindFirstChild(m,true)
            if car and IsDriverVehicle(car,char,hum) then rememberedCar=car end
        end
    end
end)

-- Death/removal/character lifecycle is centralized. CharacterAdded never starts Phase 1 directly.
permanentConnections[#permanentConnections+1]=LocalPlayer.CharacterRemoving:Connect(function(char)
    handleDeathOrRemoval("CHARACTER REMOVING",char)
end)
permanentConnections[#permanentConnections+1]=LocalPlayer.CharacterAdded:Connect(function(char)
    if resetInProgress then return end
    handleDeathOrRemoval("CHARACTER ADDED",nil)
end)

-- Preserve existing player/team/server-hop/UI integrations while preventing them from starting automation controllers.
if not ServerHopActive then
    task.defer(function()
        if LocalPlayer.Character then
            startSessionAfterRespawn()
        end
    end)
end

ExecuteAutoArrest=function()
    if ServerHopActive then return end
    if automationEnabled then return end
    startSessionAfterRespawn()
end

