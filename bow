local function antiStuckBegin(g,owner,root)
    if not validGeneration(g) then return end
    antiStuckState={generation=g,owner=owner,lastPosition=root.Position,lastProgress=tick()}
end

local function antiStuckCheck(g,owner,root)
    local a=antiStuckState
    if not a or a.generation~=g or a.owner~=owner then return false end
    if not validGeneration(g) or phase=="PHASE_1_FINAL_WAIT" or phase=="VEHICLE_ENTRY" or phase=="WAITING_FOR_RESPAWN" then return false end
    local d=(root.Position-a.lastPosition).Magnitude
    if d>=Config.AntiStuckMinMove then
        a.lastPosition=root.Position
        a.lastProgress=tick()
        return false
    end
    if tick()-a.lastProgress>=Config.AntiStuckTimeout then
        requestReset("ANTI-STUCK")
        return true
    end
    return false
end

local function sessionWait(g,seconds,owner)
    local deadline=tick()+seconds
    while tick()<deadline do
        if not validGeneration(g) or (owner and movementOwner and movementOwner~=owner) then return false end
        task.wait(0.05)
    end
    return validGeneration(g)
end

local function FlyToSession(g,root,targetPos,stopDist,speed,owner,vehicleForRay)
    if not beginMovement(g,owner) then return false end
    local attachment=trackMovement(Instance.new("Attachment"))
    attachment.Name="AutomationFlyAttachment"
    attachment.Parent=root
    local lv=trackMovement(Instance.new("LinearVelocity"))
    lv.Name="AutomationFlyVelocity"
    lv.Attachment0=attachment
    lv.RelativeTo=Enum.ActuatorRelativeTo.World
    lv.MaxForce=math.huge
    lv.VectorVelocity=Vector3.zero
    lv.Parent=root
    antiStuckBegin(g,owner,root)
    while validGeneration(g) and movementOwner==owner and root.Parent do
        if antiStuckCheck(g,owner,root) then return false end
        if (root.Position-targetPos).Magnitude<=(stopDist or 10) then
            lv.VectorVelocity=Vector3.zero
            endMovement(owner)
            return true
        end
        lv.VectorVelocity=(targetPos-root.Position).Unit*(speed or Config.PlayerFlySpeed)
        task.wait()
    end
    endMovement(owner)
    return false
end

local function approachVehicle(g,car,reason)
    local char,hum,root=getCharacter()
    if not validGeneration(g) or not char or not hum or not root then return false end
    if not vehicleIsValid(car,hum,false) then return false end
    selectedVehicle=car
    phase="VEHICLE_APPROACH"
    local seat=getVehicleSeat(car)
    if not seat then return false end
    if IsObstacleAboveSession(root,math.max(Config.CarFlyHeight,50),car,g) then
        requestReset("VEHICLE OVERHEAD BLOCKED")
        return false
    end
    if not beginMovement(g,"VEHICLE_APPROACH") then return false end
    local owner="VEHICLE_APPROACH"
    local targetHeight=seat.Position.Y+Config.CarFlyHeight
    local ascentTarget=Vector3.new(root.Position.X,targetHeight,root.Position.Z)
    local attachment=trackMovement(Instance.new("Attachment")); attachment.Name="AutomationFlyAttachment"; attachment.Parent=root
    local lv=trackMovement(Instance.new("LinearVelocity")); lv.Name="AutomationFlyVelocity"; lv.Attachment0=attachment; lv.RelativeTo=Enum.ActuatorRelativeTo.World; lv.MaxForce=math.huge; lv.Parent=root
    antiStuckBegin(g,owner,root)
    local lastY=root.Position.Y
    local lastProgress=tick()
    while validGeneration(g) and movementOwner==owner and root.Parent and root.Position.Y<targetHeight-8 do
        if not vehicleIsValid(car,hum,false) then endMovement(owner); return false end
        if vehicleIsOccupiedByOther(car,hum) then endMovement(owner); return false end
        local remaining=targetHeight-root.Position.Y
        if IsObstacleAboveSession(root,math.min(math.max(remaining+20,30),Config.CeilingCheckRayDistance),car,g) then
            endMovement(owner)
            requestReset("VEHICLE ASCENT BLOCKED")
            return false
        end
        local before=root.Position.Y
        local dir=(ascentTarget-root.Position)
        lv.VectorVelocity=dir.Magnitude>1 and dir.Unit*Config.CarAscendSpeed or Vector3.zero
        task.wait(0.08)
        if root.Position.Y-before>=0.5 then lastY=root.Position.Y; lastProgress=tick() end
        if tick()-lastProgress>=2.0 then
            endMovement(owner)
            requestReset("VEHICLE ASCENT STALLED")
            return false
        end
    end
    if not validGeneration(g) then endMovement(owner); return false end
    lv.VectorVelocity=Vector3.zero
    if not FlyToSession(g,root,Vector3.new(seat.Position.X,targetHeight,seat.Position.Z),12,Config.CarCruiseSpeed,owner,car) then
        return false
    end
    phase="VEHICLE_ENTRY"
    if not vehicleIsValid(car,hum,false) or vehicleIsOccupiedByOther(car,hum) then return false end
    local seatPos=seat.Position+Vector3.new(0,3,0)
    if not FlyToSession(g,root,seatPos,Config.VehicleEnterRadius,Config.CarDescendSpeed,owner,car) then return false end
    if not validGeneration(g) or not vehicleIsValid(car,hum,false) or vehicleIsOccupiedByOther(car,hum) then return false end
    local entered=EnterVehicleAsDriver(car)
    if entered then
        task.wait(Config.VehicleEnterDelay)
    end
    local seated=WaitForSeated(char,hum,1.5)
    endMovement(owner)
    if seated and playerIsInVehicle(char,hum) then
        phase="TARGET_FOLLOW"
        selectedVehicle=car
        return true
    end
    return false
end

local function isLastCarValid(g,car,hum)
    return validGeneration(g) and vehicleIsValid(car,hum,false) and not vehicleIsOccupiedByOther(car,hum)
end

local function returnToLastCar(g)
    local char,hum,root=getCharacter()
    local car=lastCarExited
    if not validGeneration(g) or not char or not hum or not root or not car then return false end
    if not isLastCarValid(g,car,hum) then return false end
    local seat=getVehicleSeat(car)
    if not seat then return false end
    phase="VEHICLE_RETURN"
    if (root.Position-seat.Position).Magnitude<=100 then
        return approachVehicle(g,car,"LAST_EXITED")
    end
    if IsObstacleAboveSession(root,Config.PlayerReturnFlyHeight,car,g) then
        requestReset("LAST CAR RETURN BLOCKED")
        return false
    end
    if root.Position.Y<seat.Position.Y+Config.PlayerReturnFlyHeight-5 then
        if not FlyToSession(g,root,Vector3.new(root.Position.X,seat.Position.Y+Config.PlayerReturnFlyHeight,root.Position.Z),10,Config.PlayerFlySpeed,"VEHICLE_RETURN",car) then return false end
    end
    if not validGeneration(g) or not isLastCarValid(g,car,hum) then return false end
    if not FlyToSession(g,root,Vector3.new(seat.Position.X,seat.Position.Y+Config.PlayerReturnFlyHeight,seat.Position.Z),10,Config.PlayerFlySpeed,"VEHICLE_RETURN",car) then return false end
    return approachVehicle(g,car,"LAST_EXITED")
end

local function findExpectedVehicle(root,hum)
    if vehicleIsValid(lastCarExited,hum,false) and (getVehicleSeat(lastCarExited).Position-root.Position).Magnitude<=Config.Phase1VehicleSearchRadius then
        return lastCarExited
    end
    local remembered=getgenv().GetMyCar and getgenv().GetMyCar()
    if vehicleIsValid(remembered,hum,false) and (getVehicleSeat(remembered).Position-root.Position).Magnitude<=Config.Phase1VehicleSearchRadius then
        return remembered
    end
    return nil
end

local function findNearestAvailableVehicle(root,hum)
    local folder=workspace:FindFirstChild("Vehicles")
    if not folder then return nil end
    local best,bestDist=nil,math.huge
    for _,v in ipairs(folder:GetChildren()) do
        if vehicleIsValid(v,hum,false) and not vehicleIsOccupiedByOther(v,hum) then
            local seat=getVehicleSeat(v)
            if seat then
                local d=(seat.Position-root.Position).Magnitude
                if d<=Config.Phase1VehicleSearchRadius and d<bestDist then
                    best,bestDist=v,d
                end
            end
        end
    end
    return best
end

local function selectAndEnterPhase1Vehicle(g)
    if not validGeneration(g) or not phase1Complete or phase=="PHASE_1_FINAL_WAIT" then return false end
    local char,hum,root=getCharacter()
    if not char or not hum or not root then return false end
    phase="VEHICLE_SELECTION"
    local car=findExpectedVehicle(root,hum)
    if not car then car=findNearestAvailableVehicle(root,hum) end
    if not car then
        requestReset("NO VEHICLE WITHIN 200 STUDS")
        return false
    end
    selectedVehicle=car
    if not vehicleIsValid(car,hum,false) or vehicleIsOccupiedByOther(car,hum) then return false end
    if not approachVehicle(g,car,"PHASE_1") then
        if validGeneration(g) then requestReset("VEHICLE ENTRY FAILED") end
        return false
    end
    return true
end

local function monitorDismount(g)
    local previousVehicle=selectedVehicle
    local char,hum,root=getCharacter()
    if not char or not hum then return end
    local wasIn=true
    while validGeneration(g) do
        char,hum,root=getCharacter()
        if not char or not hum or not root then return end
        local nowIn=playerIsInVehicle(char,hum)
        if wasIn and not nowIn and previousVehicle and previousVehicle.Parent then
            saveExitedVehicle(previousVehicle)
        end
        if not nowIn and lastCarExited and getVehicleSeat(lastCarExited) then
            local d=(root.Position-getVehicleSeat(lastCarExited).Position).Magnitude
            if d>100 and phase=="TARGET_FOLLOW" then
                returnToLastCar(g)
            end
        end
        if not nowIn then
            wasIn=false
        else
            wasIn=true
            previousVehicle=hum.SeatPart and hum.SeatPart.Parent or selectedVehicle
        end
        task.wait(0.5)
    end
end

local function targetFollow(g)
    local char,hum,root=getCharacter()
    if not validGeneration(g) or not char or not hum or not root then return end
    if not playerIsInVehicle(char,hum) then
        phase="VEHICLE_RETURN"
        if lastCarExited and returnToLastCar(g) then
            char,hum,root=getCharacter()
        else
            requestReset("NO USABLE VEHICLE AFTER DISMOUNT")
            return
        end
    end
    phase="TARGET_FOLLOW"
    local owner="TARGET_FOLLOW"
    if not beginMovement(g,owner) then return end
    local bodyGyro=trackMovement(Instance.new("BodyGyro")); bodyGyro.Name="AutomationBodyGyro"; bodyGyro.MaxTorque=Vector3.new(math.huge,math.huge,math.huge); bodyGyro.D=500; bodyGyro.P=150000; bodyGyro.Parent=root
    local bodyVelocity=trackMovement(Instance.new("BodyVelocity")); bodyVelocity.Name="AutomationBodyVelocity"; bodyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge); bodyVelocity.Parent=root
    antiStuckBegin(g,owner,root)
    while validGeneration(g) and movementOwner==owner do
        char,hum,root=getCharacter()
        if not char or not hum or not root then break end
        if not playerIsInVehicle(char,hum) then
            saveExitedVehicle(selectedVehicle)
            endMovement(owner)
            if not returnToLastCar(g) then requestReset("VEHICLE LOST AFTER DISMOUNT") end
            return
        end
        local plr,tr=getClosestCriminal(root)
        currentTarget=plr
        targetRoot=tr
        if not tr then
            bodyVelocity.Velocity=Vector3.zero
            antiStuckState=nil
            task.wait(0.5)
            continue
        end
        local targetPos=tr.Position
        local terrainParams=RaycastParams.new()
        terrainParams.FilterType=Enum.RaycastFilterType.Exclude
        terrainParams.FilterDescendantsInstances={char}
        terrainParams.IgnoreWater=true
        local terrainHit=workspace:Raycast(root.Position,Vector3.new(targetPos.X-root.Position.X,0,targetPos.Z-root.Position.Z),terrainParams)
        local desiredY=root.Position.Y
        if terrainHit and terrainHit.Instance==workspace.Terrain then desiredY=math.max(desiredY,targetPos.Y+50) end
        local desired=Vector3.new(targetPos.X,desiredY,targetPos.Z)
        local dist=(root.Position-desired).Magnitude
        if dist>Config.CarCruiseDistanceThreshold then
            bodyVelocity.Velocity=(desired-root.Position).Unit*Config.CarCruiseSpeed
            bodyGyro.CFrame=CFrame.lookAt(root.Position,desired)
        else
            local d3=(root.Position-targetPos).Magnitude
            if d3>Config.CarDescendDistanceThreshold then
                bodyVelocity.Velocity=(targetPos-root.Position).Unit*Config.CarDescendSpeed
                bodyGyro.CFrame=CFrame.lookAt(root.Position,targetPos)
            else
                bodyVelocity.Velocity=Vector3.zero
                bodyGyro.CFrame=CFrame.lookAt(root.Position,targetPos)
                if d3<=Config.ArrestTpDistance then
                    pcall(function() sethiddenproperty(root,"PhysicsRepRootPart",tr) end)
                    hum.Sit=false
                    root.CFrame=tr.CFrame*CFrame.new(0,3,2)*Config.TpOffset
                    EquipHandcuffs()
                    task.wait(0.1)
                    local targetChar=tr.Parent
                    local targetPlayerObj=Players:GetPlayerFromCharacter(targetChar)
                    if targetChar:GetAttribute("InVehicle") then
                        EjectNearestVehicleUser(tr)
                    elseif attemptArrest and targetPlayerObj then
                        pcall(function() attemptArrest(targetPlayerObj) end)
                    end
                    if targetChar:GetAttribute("HasHandcuffs") then
                        if targetPlayerObj then arrestedBlacklist[targetPlayerObj]=true end
                        UnequipHandcuffs()
                        bodyVelocity.Velocity=Vector3.zero
                        task.wait(0.2)
                    end
                end
            end
        end
        if antiStuckCheck(g,owner,root) then return end
        task.wait()
    end
    UnequipHandcuffs()
    endMovement(owner)
end

local function IsTargetCovered(root)
    if not root then
        return true
    end
    local rayParams=RaycastParams.new()
    rayParams.FilterType=Enum.RaycastFilterType.Exclude
    local ignoreList={LocalPlayer.Character,root.Parent}
    if workspace:FindFirstChild("Vehicles") then
        table.insert(ignoreList,workspace.Vehicles)
    end
    rayParams.FilterDescendantsInstances=ignoreList
    rayParams.IgnoreWater=true
    local rayResult=workspace:Raycast(
        root.Position,
        Vector3.new(0,Config.CeilingCheckRayDistance,0),
        rayParams
    )
    if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
        return true
    end
    return false
end
local function isTargetValid(root)
    if not root or not root.Parent then
        return false
    end
    local plr=Players:GetPlayerFromCharacter(root.Parent)
    if not plr or arrestedBlacklist[plr] then
        return false
    end
    if plr.Team and plr.Team.Name~="Criminal" then
        return false
    end
    local char=root.Parent
    if char:GetAttribute("HasHandcuffs") then
        return false
    end
    if root.Position.Y<Config.UndergroundYThreshold then
        return false
    end
    if IsTargetCovered(root) then
        return false
    end
    if char:GetAttribute("InVehicle") then
        local vehiclesDir=workspace:FindFirstChild("Vehicles")
        if vehiclesDir then
            for _,v in pairs(vehiclesDir:GetChildren()) do
                local seat=v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart",true)
                if seat and (seat.Position-root.Position).Magnitude<15 then
                    local vName=v.Name:lower()
                    if vName:find("heli") or vName:find("drone") or vName:find("blimp") then
                        return false
                    end
                end
            end
        end
    end
    return true
end
local function getClosestCriminal(p_root)
    local bestRoot,bestDist=nil,math.huge
    local selectedPlr
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=LocalPlayer and plr.Character and not arrestedBlacklist[plr] then
            if plr.Team and plr.Team.Name=="Criminal" then
                local root=plr.Character:FindFirstChild("HumanoidRootPart")
                if isTargetValid(root) then
                    local d=(root.Position-p_root.Position).Magnitude
                    if d<bestDist then
                        bestDist=d
                        bestRoot=root
                        selectedPlr=plr
                    end
                end
            end
        end
    end
    return selectedPlr,bestRoot
end

local function EquipHandcuffs()
    local invSys=require(ReplicatedStorage.Inventory.InventoryItemSystem)
    for _,item in pairs(invSys.getInventoryItemsFor(LocalPlayer)) do
        if item.obj and item.obj.Name=="Handcuffs" then
            pcall(function()
                item:AttemptSetEquipped(true)
            end)
            return true
        end
    end
    return false
end
local function UnequipHandcuffs()
    local invSys=require(ReplicatedStorage.Inventory.InventoryItemSystem)
    for _,item in pairs(invSys.getInventoryItemsFor(LocalPlayer)) do
        if item.obj and item.obj.Name=="Handcuffs" then
            pcall(function()
                item:AttemptSetEquipped(false)
            end)
            return true
        end
    end
    return false
end
local function EjectNearestVehicleUser(targetRoot)
    local targetChar=targetRoot and targetRoot.Parent
    local targetVehicle=nil
    if targetChar and targetChar:GetAttribute("InVehicle") then
        local vehiclesDir=workspace:FindFirstChild("Vehicles")
        if vehiclesDir then
            for _,v in pairs(vehiclesDir:GetChildren()) do
                local seat=v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart",true)
                if seat and (seat.Position-targetRoot.Position).Magnitude<15 then
                    targetVehicle=v
                    break
                end
            end
        end
    end
    if not targetVehicle then
        return
    end
    local uiModule=ReplicatedStorage:FindFirstChild("Module",true) and require(ReplicatedStorage.Module:FindFirstChild("UI",true) or ReplicatedStorage.Module)
    if uiModule and uiModule.CircleAction and uiModule.CircleAction.Specs then
        for _,spec in pairs(uiModule.CircleAction.Specs) do
            local isMatch=false
            if spec.Part and (targetVehicle:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(targetVehicle)) then
                isMatch=true
            elseif spec.Text and (spec.Text:lower():find("eject") or spec.Text:lower():find("passenger")) then
                isMatch=true
            end
            if isMatch then
                pcall(function()
                    spec:Callback(true)
                end)
                return
            end
        end
    end
end
local attemptArrest
for _,v in pairs(getgc(true)) do
    if type(v)=="function" and islclosure(v) then
        pcall(function()
            if tostring(getinfo(v).name)=="AttemptArrest" then
                attemptArrest=v
            end
        end)
        if attemptArrest then
            break
        end
    end
end

