local function GetServerList()
    local req=GetRequest()
    if not req then
        warn("[SERVER HOP] No HTTP request function available.")
        return nil
    end
    local cursor=""
    local servers={}
    for _=1,3 do
        local url="https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
        if cursor~="" then
            url=url.."&cursor="..HttpService:UrlEncode(cursor)
        end
        local ok,res=pcall(function()
            return req({
                Url=url,
                Method="GET",
                Headers={
                    ["Content-Type"]="application/json"
                }
            })
        end)
        if not ok or not res or not res.Body then
            warn("[SERVER HOP] Failed to get server list.")
            return nil
        end
        local decodeOk,data=pcall(function()
            return HttpService:JSONDecode(res.Body)
        end)
        if not decodeOk or not data or not data.data then
            warn("[SERVER HOP] Invalid server response.")
            return nil
        end
        for _,server in pairs(data.data) do
            if server.id and server.id~=game.JobId and server.playing and server.maxPlayers then
                table.insert(servers,server)
            end
        end
        cursor=data.nextPageCursor
        if not cursor or cursor=="" then
            break
        end
    end
    return servers
end
local function ServerHop(reason)
    if ServerHopActive then
        return
    end
    ServerHopActive=true
    getgenv().AutoArrestActive=false
    print("[SERVER HOP]",reason)
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection=nil
    end
    local servers=GetServerList()
    if servers then
        local target=nil
        for _,server in pairs(servers) do
            if server.playing>=Config.ServerHopMinPlayers and server.playing<=Config.ServerHopMaxPlayers and server.playing<server.maxPlayers then
                target=server
                break
            end
        end
        if target then
            print("[SERVER HOP] Joining server:",target.playing.."/"..target.maxPlayers)
            local options=Instance.new("TeleportOptions")
            options.ServerInstanceId=target.id
            local ok,err=pcall(function()
                TeleportService:TeleportAsync(game.PlaceId,{LocalPlayer},options)
            end)
            if ok then
                return
            end
            warn("[SERVER HOP] Teleport failed:",err)
        end
    end
    ServerHopActive=false
    print("[SERVER HOP] No suitable server found, using normal teleport.")
    pcall(function()
        TeleportService:Teleport(game.PlaceId,LocalPlayer)
    end)
end
local function CheckServerHop()
    local playerCount=#Players:GetPlayers()
    local criminalCount=GetCriminalCount()
    print("[SERVER CHECK] Players:",playerCount,"Criminals:",criminalCount)
    if playerCount>=Config.AntiFullServerPlayers then
