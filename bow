local function EnterVehicleAsDriver(carModel)
    local uiModule=ReplicatedStorage:FindFirstChild("Module",true) and require(ReplicatedStorage.Module:FindFirstChild("UI",true) or ReplicatedStorage.Module)
    if not uiModule or not uiModule.CircleAction or not uiModule.CircleAction.Specs then
        return false
    end
    local driverSeat=carModel and (carModel:FindFirstChild("Seat") or carModel:FindFirstChild("VehicleSeat"))
    if driverSeat then
        for _,spec in pairs(uiModule.CircleAction.Specs) do
            if spec.Part==driverSeat then
                pcall(function()
                    spec:Callback(true)
                end)
                return true
            end
        end
    end
    for _,spec in pairs(uiModule.CircleAction.Specs) do
        if spec.Part and carModel and spec.Part:IsDescendantOf(carModel) then
            local text=(spec.Text or ""):lower()
            if text:find("driver") or text:find("drive") then
                pcall(function()
                    spec:Callback(true)
                end)
                return true
            end
        end
    end
    for _,spec in pairs(uiModule.CircleAction.Specs) do
        if spec.Part and carModel and spec.Part:IsDescendantOf(carModel) then
            local text=(spec.Text or ""):lower()
            local partName=spec.Part.Name:lower()
            if not text:find("passenger") and not text:find("eject") and not partName:find("passenger") then
                pcall(function()
                    spec:Callback(true)
                end)
                return true
            end
        end
    end
    return false
end
