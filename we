local function CriminalCount()
	local n=0
	for _,p in ipairs(Players:GetPlayers()) do
		if p.Team and p.Team.Name=="Criminal" then n+=1 end
	end
	return n
end

local function ServerHop(reason)
	if ServerHopActive then return end
	ServerHopActive=true
	StopCycle()
	local req=GetRequest()
	local servers={}
	if req then
		local ok,res=pcall(function()
			return req({
				Url="https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100",
				Method="GET",
				Headers={["Content-Type"]="application/json"}
			})
		end)
		if ok and res and res.Body then
			local decodeOk,data=pcall(function() return HttpService:JSONDecode(res.Body) end)
			if decodeOk and data and data.data then servers=data.data end
		end
	end
	for _,server in ipairs(servers) do
		if server.id~=game.JobId and server.playing and server.maxPlayers and server.playing>=Config.ServerHopMinPlayers and server.playing<=Config.ServerHopMaxPlayers and server.playing<server.maxPlayers then
			local options=Instance.new("TeleportOptions")
			options.ServerInstanceId=server.id
			if pcall(function() TeleportService:TeleportAsync(game.PlaceId,{LocalPlayer},options) end) then return end
		end
	end
	pcall(function() TeleportService:Teleport(game.PlaceId,LocalPlayer) end)
end

local function CheckServer()
	local players=#Players:GetPlayers()
	local criminals=CriminalCount()
	if players>=Config.AntiFullServerPlayers then
		ServerHop("ANTI-FULL SERVER")
		return true
	end
	if players>=Config.ServerHopMinPlayers and players<=Config.ServerHopMaxPlayers and criminals<Config.ServerHopCriminalLimit then
		ServerHop("TOO FEW CRIMINALS")
		return true
	end
	return false
end

