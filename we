local function EscapeStation(id)
	State="ESCAPE_BUILDING"
	local closest,minDist=nil,math.huge
	for _,station in ipairs(Stations) do
		local d=(RootPart.Position-station.Base).Magnitude
		if d<minDist then closest,minDist=station,d end
	end
	if not closest then return false end
	for _,point in ipairs(closest.Path) do
		if not CharacterValid(id) or State~="ESCAPE_BUILDING" then return false end
		RootPart.CFrame=CFrame.new(point)
		task.wait(Config.WaypointDelay)
	end
	return CharacterValid(id)
end

local function FindAndEnterVehicle(id)
	State="FIND_VEHICLE"
	local vehicle=FindNearestVehicle(RootPart.Position,Config.VehicleSearchRadius)
	if not vehicle then return false end
	State="TRAVEL_TO_VEHICLE"
	if not StartFlight(id,vehicle) then return false end
	local seat=GetSeat(vehicle)
	if not seat then return false end
	if not MoveTo(id,Vector3.new(RootPart.Position.X,Config.InitialVehicleAltitude,RootPart.Position.Z),Config.PlayerFlySpeed,8,vehicle) then return false end
	if not MoveTo(id,Vector3.new(seat.Position.X,Config.InitialVehicleAltitude,seat.Position.Z),Config.CruiseSpeed,10,vehicle) then return false end
	if not MoveTo(id,seat.Position+Vector3.new(0,3,0),Config.PlayerFlySpeed,10,vehicle) then return false end
	CleanupMovement()
	State="ENTER_VEHICLE"
	return EnterVehicle(vehicle,id)
end

local function ApproachTarget(id,target)
	State="APPROACH_TARGET"
	CurrentTarget=target
	local deadline=os.clock()+Config.TargetTimeout
	if not StartFlight(id,CurrentVehicle) then return false end
	while CharacterValid(id) and TargetValid(target) and os.clock()<deadline do
		local root=target.Character.HumanoidRootPart
		local targetPos=root.Position
		local distance=(RootPart.Position-targetPos).Magnitude
		if distance<=Config.TargetCloseDistance then break end
		local altitude=math.max(targetPos.Y+Config.TargetCloseDistance,Config.TargetCruiseAltitude)
		local point=Vector3.new(targetPos.X,altitude,targetPos.Z)
		if not MoveTo(id,point,Config.CruiseSpeed,10,CurrentVehicle) then return false end
		root=target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		if not root then return false end
		if (RootPart.Position-root.Position).Magnitude<=Config.TargetCloseDistance then break end
	end
	if not CharacterValid(id) or not TargetValid(target) then return false end
	while CharacterValid(id) and TargetValid(target) do
		local root=target.Character:FindFirstChild("HumanoidRootPart")
		if not root then return false end
		local d=(RootPart.Position-root.Position).Magnitude
		if d<=Config.TargetCloseDistance then return true end
		local blocked=RayBlocked(RootPart.Position,root.Position-RootPart.Position,CurrentVehicle)
		if blocked then RequestReset(id) return false end
		BodyVelocity.Velocity=(root.Position-RootPart.Position).Unit*Config.DescendSpeed
		BodyGyro.CFrame=CFrame.lookAt(RootPart.Position,root.Position)
		task.wait(0.05)
	end
	return false
end

local function ArrestTarget(id,target)
	State="RAM_TARGET"
	local root=target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	if target.Character:GetAttribute("InVehicle") then
		RamTarget(id,target)
	end
	if not ExitVehicle(id) then return false end
	State="EQUIP_HANDCUFFS"
	local deadline=os.clock()+2
	while CharacterValid(id) and os.clock()<deadline do
		if EquipHandcuffs() and HandcuffsEquipped() then break end
		task.wait(0.1)
	end
	if not HandcuffsEquipped() then return false end
	State="EJECT_TARGET"
	EjectTarget(id,target)
	State="ARREST_TARGET"
	if not CharacterValid(id) or not TargetValid(target) then return false end
	root=target.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	pcall(function() sethiddenproperty(RootPart,"PhysicsRepRootPart",root) end)
	RootPart.CFrame=root.CFrame*CFrame.new(0,3,2)*Config.TpOffset
	if AttemptArrest then
		pcall(function() AttemptArrest(target) end)
	end
	if not ConfirmArrest(id,target) then return false end
	TargetBlacklist[target]=true
	CurrentTarget=nil
	TargetRoot=nil
	return true
end

local function Cycle(id)
	State="ASCEND"
	if not Ascend(id,Config.TargetCruiseAltitude,CurrentVehicle) then return false end
	CleanupMovement()
	State="FIND_TARGET"
	local target
	while CharacterValid(id) do
		target=FindTarget()
		if target then break end
		task.wait(0.25)
	end
	if not target then return false end
	if not ApproachTarget(id,target) then return false end
	if not CharacterValid(id) then return false end
	if not ArrestTarget(id,target) then return false end
	State="RETURN_TO_VEHICLE"
	local oldVehicle=LastExitedVehicle
	local targetPosition=target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character.HumanoidRootPart.Position or RootPart.Position
	CleanupMovement()
	if oldVehicle and oldVehicle.Parent then
		if not ReturnToVehicle(id,oldVehicle,targetPosition) then
			local camaro=SpawnCamaro(id)
			if not camaro then return false end
			if not EnterVehicle(camaro,id) then return false end
		end
	else
		local camaro=SpawnCamaro(id)
		if not camaro or not EnterVehicle(camaro,id) then return false end
	end
	CleanupMovement()
	State="ASCEND"
	return Ascend(id,Config.TargetCruiseAltitude,CurrentVehicle)
end

local function StartCycle()
	if ResetInProgress then return end
	StopCycle()
	local id=NewCycle()
	getgenv().AutoArrestActive=true
	getgenv().LagbackCount=0
	TargetBlacklist={}
	if not RefreshCharacter(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()) then
		getgenv().AutoArrestActive=false
		return
	end
	if not CharacterValid(id) then return end
	if not EscapeStation(id) then return end
	if not FindAndEnterVehicle(id) then
		RequestReset(id)
		return
	end
	while CharacterValid(id) do
		local started=os.clock()
		if not Cycle(id) then
			if CharacterValid(id) then
				RequestReset(id)
			end
			return
		end
		if os.clock()-started>Config.CycleTimeout then
			RequestReset(id)
			return
		end
		task.wait(0.1)
	end
end

local function BindCharacter(char)
	Disconnect("Died")
	Character=char
	Humanoid=nil
	RootPart=nil
	getgenv().AutoArrestActive=false
	CycleId+=1
	CleanupMovement()
	ClearCycleState()
	if not char then return end
	Humanoid=char:WaitForChild("Humanoid",10)
	RootPart=char:WaitForChild("HumanoidRootPart",10)
	if not Humanoid or not RootPart then return end
	Connections.Died=Humanoid.Died:Connect(function()
		CycleId+=1
		getgenv().AutoArrestActive=false
		CleanupMovement()
		CurrentTarget=nil
		TargetRoot=nil
		CurrentVehicle=nil
		LastEnteredVehicle=nil
		LastExitedVehicle=nil
		State="WAITING_FOR_RESPAWN"
	end)
	task.spawn(function()
		task.wait(1)
		if LocalPlayer.Character~=char or ResetInProgress or ServerHopActive then return end
		StartCycle()
	end)
end

