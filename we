local CycleId=0
local State="IDLE"
local Character=nil
local Humanoid=nil
local RootPart=nil
local CurrentVehicle=nil
local LastEnteredVehicle=nil
local LastExitedVehicle=nil
local CurrentTarget=nil
local TargetRoot=nil
local TargetBlacklist={}
local BodyGyro=nil
local BodyVelocity=nil
local LinearVelocity=nil
local FlyAttachment=nil
local ResetInProgress=false
local ServerHopActive=false
local Connections={}
local rememberedCar=nil

getgenv().AutoArrestActive=false
getgenv().LagbackCount=0

local function NewCycle()
	CycleId+=1
	return CycleId
end

local function ValidCycle(id)
	return id==CycleId and getgenv().AutoArrestActive and Character==LocalPlayer.Character and Character~=nil and Humanoid~=nil and RootPart~=nil and Humanoid.Parent==Character and RootPart.Parent==Character and Humanoid.Health>0
end

local function Disconnect(name)
	local c=Connections[name]
	if c then
		pcall(function() c:Disconnect() end)
		Connections[name]=nil
	end
end

local function CleanupMovement()
	if BodyVelocity then pcall(function() BodyVelocity:Destroy() end) BodyVelocity=nil end
	if BodyGyro then pcall(function() BodyGyro:Destroy() end) BodyGyro=nil end
	if LinearVelocity then pcall(function() LinearVelocity:Destroy() end) LinearVelocity=nil end
	if FlyAttachment then pcall(function() FlyAttachment:Destroy() end) FlyAttachment=nil end
	if RootPart then
		pcall(function()
			RootPart.AssemblyLinearVelocity=Vector3.zero
			RootPart.AssemblyAngularVelocity=Vector3.zero
		end)
	end
end

local function ClearCycleState()
	CurrentVehicle=nil
	LastEnteredVehicle=nil
	LastExitedVehicle=nil
	CurrentTarget=nil
	TargetRoot=nil
	TargetBlacklist={}
	State="IDLE"
end

local function StopCycle()
	CycleId+=1
	getgenv().AutoArrestActive=false
	CleanupMovement()
	for name in pairs(Connections) do Disconnect(name) end
	ClearCycleState()
end

local function CharacterValid(id)
	return ValidCycle(id)
end

local function RefreshCharacter(char)
	Character=char
	Humanoid=char and char:FindFirstChildOfClass("Humanoid") or nil
	RootPart=char and char:FindFirstChild("HumanoidRootPart") or nil
	if not Humanoid and char then
		Humanoid=char:WaitForChild("Humanoid",10)
	end
	if not RootPart and char then
		RootPart=char:WaitForChild("HumanoidRootPart",10)
	end
	return Character==char and Humanoid~=nil and RootPart~=nil
end

local function RequestReset(id)
	if id and id~=CycleId then return end
	if ResetInProgress then return end
	ResetInProgress=true
	StopCycle()
	task.spawn(function()
		pcall(function()
			if Humanoid and Humanoid.Health>0 then
				Humanoid.Health=0
			else
				LocalPlayer:LoadCharacter()
			end
		end)
		task.wait()
		ResetInProgress=false
	end)
end

local function IsInVehicle()
	return (Character and Character:GetAttribute("InVehicle")==true) or (Humanoid and Humanoid.SeatPart~=nil)
end

local function GetSeat(vehicle)
	if not vehicle then return nil end
	return vehicle:FindFirstChild("Seat") or vehicle:FindFirstChild("VehicleSeat") or vehicle:FindFirstChildWhichIsA("VehicleSeat",true)
end

local function IsDriverVehicle(vehicle)
	if not vehicle or not vehicle.Parent or not Humanoid then return false end
	local seat=GetSeat(vehicle)
	if seat and seat.Occupant==Humanoid then return true end
	local driver=vehicle:FindFirstChild("Driver",true)
	return driver and driver:IsA("ObjectValue") and driver.Value==LocalPlayer
end

local function VehicleUsable(vehicle,groundOnly)
	if not vehicle or not vehicle.Parent then return false end
	local seat=GetSeat(vehicle)
	if not seat or not seat.Parent then return false end
	if seat.Occupant and seat.Occupant~=Humanoid then return false end
	if groundOnly then
		local n=vehicle.Name:lower()
		if n:find("heli") or n:find("helicopter") or n:find("drone") or n:find("blimp") or n:find("ufo") or n:find("blackhawk") then
			return false
		end
	end
	return true
end

local function GetVehicles()
	return workspace:FindFirstChild("Vehicles")
end

local function FindNearestVehicle(position,radius)
	local folder=GetVehicles()
	if not folder then return nil end
	local best,bestDist=nil,radius or Config.VehicleSearchRadius
	for _,vehicle in ipairs(folder:GetChildren()) do
		if VehicleUsable(vehicle,true) then
			local seat=GetSeat(vehicle)
			local d=(seat.Position-position).Magnitude
			if d<bestDist then
				best,bestDist=vehicle,d
			end
		end
	end
	return best
end

local function CircleAction()
	return Modules.UI and Modules.UI.CircleAction
end

local function EnterVehicle(vehicle,id)
	if not CharacterValid(id) or not VehicleUsable(vehicle,true) then return false end
	local circle=CircleAction()
	if not circle or not circle.Specs then return false end
	local seat=GetSeat(vehicle)
	local fired=false
	for _,spec in pairs(circle.Specs) do
		if spec.Part==seat then
			pcall(function() spec:Callback(true) end)
			fired=true
			break
		end
	end
	if not fired then
		for _,spec in pairs(circle.Specs) do
			if spec.Part and spec.Part:IsDescendantOf(vehicle) then
				local text=tostring(spec.Text or ""):lower()
				if (text:find("driver") or text:find("drive")) and not text:find("passenger") then
					pcall(function() spec:Callback(true) end)
					fired=true
					break
				end
			end
		end
	end
	if not fired then return false end
	local deadline=os.clock()+Config.VehicleEntryTimeout
	while os.clock()<deadline do
		if not CharacterValid(id) then return false end
		if IsDriverVehicle(vehicle) then
			CurrentVehicle=vehicle
			LastEnteredVehicle=vehicle
			return true
		end
		task.wait(0.05)
	end
	return false
end

local function ExitVehicle(id)
	if not CharacterValid(id) then return false end
	local vehicle=CurrentVehicle
	if not vehicle and Humanoid then
		local seat=Humanoid.SeatPart
		vehicle=seat and seat:FindFirstAncestorOfClass("Model")
	end
	if not IsInVehicle() then return true end
	pcall(function()
		VirtualInputManager:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
		task.wait(0.1)
		VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
	end)
	pcall(function() Humanoid.Sit=false end)
	local deadline=os.clock()+2
	while os.clock()<deadline do
		if not CharacterValid(id) then return false end
		if not IsInVehicle() then
			LastExitedVehicle=vehicle
			CurrentVehicle=nil
			return true
		end
		task.wait(0.05)
	end
	return false
end

local function WaitForVehicle(id,vehicle,timeout)
	local deadline=os.clock()+timeout
	while os.clock()<deadline do
		if not CharacterValid(id) then return nil end
		if vehicle and vehicle.Parent and VehicleUsable(vehicle,true) then return vehicle end
		task.wait(0.1)
	end
	return nil
end

local function RayBlocked(origin,direction,ignore)
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	params.IgnoreWater=true
	local list={Character}
	if ignore and ignore.Parent then table.insert(list,ignore) end
	params.FilterDescendantsInstances=list
	local result=workspace:Raycast(origin,direction,params)
	return result and result.Instance and result.Instance.CanCollide,result
end

local function GroundDistance(position,ignore)
	local blocked,result=RayBlocked(position,Vector3.new(0,-Config.GroundCheckDistance,0),ignore)
	if blocked and result then return (position-result.Position).Magnitude,result end
	return nil,nil
end

local function StartFlight(id,vehicle)
	if not CharacterValid(id) then return false end
	CleanupMovement()
	BodyGyro=Instance.new("BodyGyro")
	BodyGyro.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
	BodyGyro.D=500
	BodyGyro.P=150000
	BodyGyro.Parent=RootPart
	BodyVelocity=Instance.new("BodyVelocity")
	BodyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
	BodyVelocity.Parent=RootPart
	return true
end

local function Ascend(id,height,vehicle)
	if not StartFlight(id,vehicle) then return false end
	while CharacterValid(id) and RootPart.Position.Y<height do
		local blocked=RayBlocked(RootPart.Position,Vector3.new(0,Config.CeilingCheckDistance,0),vehicle)
		if blocked then
			CleanupMovement()
			RequestReset(id)
			return false
		end
		BodyVelocity.Velocity=Vector3.new(0,Config.CarAscendSpeed,0)
		BodyGyro.CFrame=CFrame.lookAt(RootPart.Position,RootPart.Position+Vector3.new(0,0,-1))
		task.wait(0.05)
	end
	if not CharacterValid(id) then return false end
	BodyVelocity.Velocity=Vector3.zero
	return true
end

local function MoveTo(id,position,speed,stopDistance,ignore)
	while CharacterValid(id) do
		local delta=position-RootPart.Position
		local distance=delta.Magnitude
		if distance<=(stopDistance or 8) then return true end
		local blocked=RayBlocked(RootPart.Position,delta.Unit*math.min(distance,40),ignore)
		if blocked then
			CleanupMovement()
			RequestReset(id)
			return false
		end
		BodyVelocity.Velocity=delta.Unit*(speed or Config.CruiseSpeed)
		BodyGyro.CFrame=CFrame.lookAt(RootPart.Position,position)
		task.wait(0.05)
	end
	return false
end

local function TrackTargetVehicle(targetRoot)
	local folder=GetVehicles()
	if not folder then return nil end
	for _,vehicle in ipairs(folder:GetChildren()) do
		local seat=GetSeat(vehicle)
		if seat and (seat.Position-targetRoot.Position).Magnitude<=15 then return vehicle end
	end
	return nil
end

local function Aircraft(vehicle)
	if not vehicle then return false end
	local n=vehicle.Name:lower()
	return n:find("heli") or n:find("helicopter") or n:find("drone") or n:find("blimp") or n:find("ufo") or n:find("blackhawk")
end

local function TargetValid(player)
	if not player or player==LocalPlayer or TargetBlacklist[player] then return false end
	if not player.Character or player.Team==nil or player.Team.Name~="Criminal" then return false end
	local char=player.Character
	local hum=char:FindFirstChildOfClass("Humanoid")
	local root=char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health<=0 then return false end
	if char:GetAttribute("HasHandcuffs") then return false end
	if root.Position.Y<15 then return false end
	if char:GetAttribute("InVehicle") then
		local vehicle=TrackTargetVehicle(root)
		if vehicle and Aircraft(vehicle) then return false end
	end
	return true
end

local function FindTarget()
	local best,bestDist=nil,math.huge
	for _,player in ipairs(Players:GetPlayers()) do
		if TargetValid(player) then
			local root=player.Character.HumanoidRootPart
			local distance=(root.Position-RootPart.Position).Magnitude
			if distance<bestDist then
				best,bestDist=player,distance
			end
		end
	end
	return best
end

local function EquipHandcuffs()
	local system=Modules.ItemSystem or Require("Inventory.InventoryItemSystem")
	if not system or type(system.getInventoryItemsFor)~="function" then return false end
	local ok,items=pcall(function() return system.getInventoryItemsFor(LocalPlayer) end)
	if not ok or not items then return false end
	for _,item in pairs(items) do
		if item.obj and item.obj.Name=="Handcuffs" then
			pcall(function() item:AttemptSetEquipped(true) end)
			return true
		end
	end
	return false
end

local function HandcuffsEquipped()
	local system=Modules.ItemSystem or Require("Inventory.InventoryItemSystem")
	if not system or type(system.getInventoryItemsFor)~="function" then return false end
	local ok,items=pcall(function() return system.getInventoryItemsFor(LocalPlayer) end)
	if not ok or not items then return false end
	for _,item in pairs(items) do
		if item.obj and item.obj.Name=="Handcuffs" then
			return item.obj.Parent~=nil
		end
	end
	return false
end

local AttemptArrest
pcall(function()
	for _,fn in pairs(getgc(true)) do
		if type(fn)=="function" and islclosure and islclosure(fn) then
			local info=getinfo and getinfo(fn)
			if info and tostring(info.name)=="AttemptArrest" then
				AttemptArrest=fn
				break
			end
		end
	end
end)

local function EjectTarget(id,target)
	local root=target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local vehicle=TrackTargetVehicle(root)
	if not vehicle then return true end
	local circle=CircleAction()
	if not circle or not circle.Specs then return false end
	local deadline=os.clock()+Config.EjectTimeout
	while CharacterValid(id) and TargetValid(target) and target.Character:GetAttribute("InVehicle") and os.clock()<deadline do
		for _,spec in pairs(circle.Specs) do
			local text=tostring(spec.Text or ""):lower()
			if spec.Part and spec.Part:IsDescendantOf(vehicle) and (text:find("eject") or text:find("passenger")) then
				pcall(function() spec:Callback(true) end)
				break
			end
		end
		task.wait(0.15)
	end
	return not target.Character:GetAttribute("InVehicle")
end

local function ConfirmArrest(id,target)
	local deadline=os.clock()+Config.ArrestTimeout
	while CharacterValid(id) and os.clock()<deadline do
		if not TargetValid(target) or (target.Character and target.Character:GetAttribute("HasHandcuffs")) then
			return true
		end
		task.wait(0.1)
	end
	return target.Character and target.Character:GetAttribute("HasHandcuffs")==true
end

local function RamTarget(id,target)
	local root=target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local vehicle=TrackTargetVehicle(root)
	if not vehicle then return true end
	local initial=vehicle:GetAttribute("VehicleTiresLastPop")
	local deadline=os.clock()+Config.CarMaxRamDuration
	while CharacterValid(id) and TargetValid(target) and vehicle.Parent and os.clock()<deadline do
		pcall(function() sethiddenproperty(RootPart,"PhysicsRepRootPart",root) end)
		RootPart.CFrame=root.CFrame*Config.TpOffset
		BodyVelocity.Velocity=Vector3.zero
		local current=vehicle:GetAttribute("VehicleTiresLastPop")
		if initial~=nil and current~=nil and current~=initial then return true end
		if not target.Character:GetAttribute("InVehicle") then return true end
		task.wait()
	end
	return initial~=nil and vehicle:GetAttribute("VehicleTiresLastPop")~=initial
end

local function SpawnCamaro(id)
	local remote=ReplicatedStorage:FindFirstChild("GarageSpawnVehicle",true)
	if not remote then return nil end
	local before={}
	local folder=GetVehicles()
	if folder then for _,v in ipairs(folder:GetChildren()) do before[v]=true end end
	pcall(function() remote:FireServer("Chassis","Camaro") end)
	local deadline=os.clock()+Config.CamaroSpawnTimeout
	while CharacterValid(id) and os.clock()<deadline do
		folder=GetVehicles()
		if folder then
			for _,vehicle in ipairs(folder:GetChildren()) do
				if not before[vehicle] and vehicle.Name:lower():find("camaro") and VehicleUsable(vehicle,true) then
					return vehicle
				end
			end
		end
		task.wait(0.1)
	end
	return nil
end

local function ReturnToVehicle(id,vehicle,targetPosition)
	if not vehicle or not vehicle.Parent then return false end
	local seat=GetSeat(vehicle)
	if not seat then return false end
	local distance=(RootPart.Position-seat.Position).Magnitude
	if distance>=Config.VehicleTooFarDistance then
		local offset=targetPosition and targetPosition+Vector3.new(0,0,Config.CamaroSpawnDistance) or RootPart.Position+Vector3.new(0,0,Config.CamaroSpawnDistance)
		if not MoveTo(id,Vector3.new(RootPart.Position.X,Config.ReturnVehicleAltitude,RootPart.Position.Z),Config.PlayerFlySpeed,8,vehicle) then return false end
		if not MoveTo(id,Vector3.new(offset.X,Config.ReturnVehicleAltitude,offset.Z),Config.CruiseSpeed,8,vehicle) then return false end
		local ground=GroundDistance(RootPart.Position,vehicle)
		if not ground or ground>Config.GroundCheckDistance then return false end
		CleanupMovement()
		local camaro=SpawnCamaro(id)
		if not camaro then return false end
		local camSeat=GetSeat(camaro)
		if not camSeat then return false end
		if not StartFlight(id,camaro) then return false end
		if not MoveTo(id,camSeat.Position+Vector3.new(0,3,0),Config.PlayerFlySpeed,10,camaro) then return false end
		CleanupMovement()
		return EnterVehicle(camaro,id)
	end
	if not StartFlight(id,vehicle) then return false end
	if not MoveTo(id,Vector3.new(seat.Position.X,Config.ReturnVehicleAltitude,seat.Position.Z),Config.CruiseSpeed,10,vehicle) then return false end
	if not MoveTo(id,seat.Position+Vector3.new(0,3,0),Config.PlayerFlySpeed,10,vehicle) then return false end
	CleanupMovement()
	return EnterVehicle(vehicle,id)
end

