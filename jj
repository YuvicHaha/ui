	while task.wait(0.5) do
		if stateRunning then
			pcall(refreshRememberedCar)
		end
	end
end)

local function isActuallyInVehicle()
	if not currentCharacter or not currentHumanoid then
		return false
	end
	if currentCharacter:GetAttribute("InVehicle")==true then
		return true
	end
	return currentHumanoid.SeatPart~=nil
end

local function isActuallyOutsideVehicle()
	if not currentCharacter or not currentHumanoid then
		return true
	end
	if currentCharacter:GetAttribute("InVehicle")==false or currentCharacter:GetAttribute("InVehicle")==nil then
		return currentHumanoid.SeatPart==nil
	end
	return false
end

local function findSeatSpec(vehicle)
	if not vehicle or not vehicle.Parent then
		return nil
	end
	local seat=getSeat(vehicle)
	if not seat then
		return nil
	end
	local specs=UI and UI.CircleAction and UI.CircleAction.Specs
	if type(specs)~="table" then
		return nil
	end
	for _,spec in pairs(specs) do
		if type(spec)=="table" and spec.Part and spec.Part==seat and type(spec.Callback)=="function" then
			return spec
		end
	end
	return nil
end

local function triggerVehicleSeat(vehicle)
	local spec=findSeatSpec(vehicle)
	if not spec then
		return false
	end
	local ok=pcall(function()
		spec:Callback(true)
	end)
	return ok
end

local function vehicleUsable(vehicle)
	if not vehicle or not vehicle.Parent or not isVehicleModel(vehicle) then
		return false
	end
	local seat=getSeat(vehicle)
	if not seat then
		return false
	end
	return true
end

local function getVehicleDriver(vehicle)
	if not vehicle or not vehicle.Parent then
		return nil
	end
	local seat=getSeat(vehicle)
	if not seat then
		return nil
	end
	local occupant=seat.Occupant
	if occupant and occupant.Parent then
		return Players:GetPlayerFromCharacter(occupant.Parent)
	end
	return nil
end

local function selectNearestLocalVehicle(maxDistance)
	if not currentRoot then
		return nil
	end
	local vehicles=Workspace:FindFirstChild("Vehicles")
	if not vehicles then
		return nil
	end
	local best=nil
	local bestDistance=maxDistance or math.huge
	for _,vehicle in ipairs(vehicles:GetChildren()) do
		if vehicleUsable(vehicle) then
			local seat=getSeat(vehicle)
			local distance=(seat.Position-currentRoot.Position).Magnitude
			if distance<=bestDistance then
				local driver=getVehicleDriver(vehicle)
				if not driver or driver==LocalPlayer then
					best=vehicle
					bestDistance=distance
				end
			end
		end
	end
	return best
end

local function verifyLocalVehicle(expected)
	local started=os.clock()
	while os.clock()-started<2 do
		if isActuallyInVehicle() then
			local actual=refreshRememberedCar()
			if actual and isVehicleModel(actual) then
				if not expected or actual==expected or actual:IsDescendantOf(expected) or expected:IsDescendantOf(actual) then
					return actual
				end
			end
			if expected and expected.Parent then
				return expected
			end
		end
		task.wait(0.05)
	end
	return nil
end

local function enterVehicle(vehicle,token,timeout)
	if not tokenValid(token) or not vehicleUsable(vehicle) then
		return nil
	end
	timeout=timeout or 4
	local started=os.clock()
	while os.clock()-started<timeout do
		if not tokenValid(token) then
			return nil
		end
		if isActuallyInVehicle() then
			local actual=refreshRememberedCar()
			if actual and isVehicleModel(actual) then
				return actual
			end
			if vehicle.Parent then
				return vehicle
			end
		end
		if vehicle.Parent and vehicleUsable(vehicle) then
			local seat=getSeat(vehicle)
			if seat and (seat.Position-currentRoot.Position).Magnitude<=Config.VehicleSearchDistance+5 then
				triggerVehicleSeat(vehicle)
			end
		end
		task.wait(0.12)
	end
	return verifyLocalVehicle(vehicle)
end

local function findAndEnterLocalVehicle(token,preferred)
	if not tokenValid(token) then
		return nil
	end
	local candidates={}
	if preferred and vehicleUsable(preferred) then
		table.insert(candidates,preferred)
	end
	local vehicles=Workspace:FindFirstChild("Vehicles")
	if vehicles then
		local ranked={}
		for _,vehicle in ipairs(vehicles:GetChildren()) do
			if vehicleUsable(vehicle) and vehicle~=preferred then
				local seat=getSeat(vehicle)
				if seat then
					table.insert(ranked,{vehicle=vehicle,distance=(seat.Position-currentRoot.Position).Magnitude})
				end
			end
		end
		table.sort(ranked,function(a,b)
			return a.distance<b.distance
		end)
		for _,entry in ipairs(ranked) do
			table.insert(candidates,entry.vehicle)
		end
	end
	for _,vehicle in ipairs(candidates) do
		if not tokenValid(token) then
			return nil
		end
		local seat=getSeat(vehicle)
		if seat and (seat.Position-currentRoot.Position).Magnitude<=Config.VehicleSearchDistance+10 then
			for _=1,3 do
				local actual=enterVehicle(vehicle,token,0.8)
				if actual then
					return actual
				end
				task.wait(0.1)
			end
		end
	end
	return nil
end

local function moveToWaypoint(point,token)
	if not tokenValid(token) then
		return false
	end
	currentRoot.CFrame=CFrame.new(point)
	task.wait(Config.WaypointDelay)
	return tokenValid(token)
end

local function runPhase1(token)
	phase="Phase1"
	InitialStationPhase=true
	Phase1Complete=false
	destroyFlight()
	local nearest=nil
	local nearestDistance=math.huge
	for _,station in pairs(PoliceData) do
		local distance=(currentRoot.Position-station.Base).Magnitude
		if distance<nearestDistance then
			nearestDistance=distance
			nearest=station
		end
	end
	if not nearest then
		return false
	end
	for _,point in ipairs(nearest.Path) do
		if not moveToWaypoint(point,token) then
			return false
		end
	end
	task.wait(Config.PostPathDelay)
	if not tokenValid(token) then
		return false
	end
	InitialStationPhase=false
	Phase1Complete=true
	return true
end

local function ascendBy(amount,token)
	local destination=currentRoot.Position.Y+amount
	while tokenValid(token) and math.abs(currentRoot.Position.Y-destination)>3 do
		if not safeVerticalMove(destination,Config.AscendSpeed,token) then
			return false
		end
		task.wait()
	end
	return tokenValid(token)
end

local function ascendToHeight(height,token)
	while tokenValid(token) and math.abs(currentRoot.Position.Y-height)>4 do
		local speed=height>currentRoot.Position.Y and Config.AscendSpeed or Config.DescendSpeed
		if not safeVerticalMove(height,speed,token) then
			return false
		end
		task.wait()
	end
	return tokenValid(token)
end

local function isTargetCovered(root)
	if not root or not root.Parent then
		return true
	end
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	local ignore={root.Parent}
	if currentCharacter then
		table.insert(ignore,currentCharacter)
	end
	if currentVehicle then
		table.insert(ignore,currentVehicle)
	end
	params.FilterDescendantsInstances=ignore
	local direction=currentRoot and (root.Position-currentRoot.Position) or Vector3.zero
	if direction.Magnitude>0 then
		local result=Workspace:Raycast(currentRoot.Position,direction,params)
		if result and not result.Instance:IsDescendantOf(root.Parent) then
			return true
		end
	end
	return false
end

local function targetVehicleForPlayer(player)
	if not player then
		return nil
	end
	local character=player.Character
	if not character then
		return nil
	end
	local root=character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local vehicles=Workspace:FindFirstChild("Vehicles")
	if not vehicles then
		return nil
	end
	local best=nil
	local bestDistance=18
	for _,vehicle in ipairs(vehicles:GetChildren()) do
		if vehicle:IsA("Model") then
			local seat=getSeat(vehicle)
			if seat then
				local d=(seat.Position-root.Position).Magnitude
				if d<bestDistance then
					bestDistance=d
					best=vehicle
				end
			end
		end
	end
	return best
end

local function validTarget(player)
	if not player or player==LocalPlayer then
		return false
	end
	if arrestedBlacklist[player] then
		return false
	end
	local character=player.Character
	if not character or not character.Parent then
		return false
	end
	local humanoid=character:FindFirstChildOfClass("Humanoid")
	local root=character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health<=0 or not root then
		return false
	end
	if player.Team and player.Team.Name~="Criminal" then
		if player.Team.Name=="Prisoner" then
			arrestedBlacklist[player]=nil
		end
		return false
	end
	if character:GetAttribute("HasHandcuffs") then
		return false
	end
	if root.Position.Y<Config.UndergroundYThreshold then
		return false
	end
	if IsTargetCovered and IsTargetCovered(root) then
		return false
	end
	if character:GetAttribute("InVehicle")==true then
		local vehicle=targetVehicleForPlayer(player)
		if vehicle and isSpecialVehicle(vehicle) then
			return false
		end
	end
	return true
end

local function findNearestTarget()
	if not currentRoot then
		return nil
	end
	local best=nil
	local bestDistance=math.huge
	for _,player in ipairs(Players:GetPlayers()) do
		if validTarget(player) then
			local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local distance=(root.Position-currentRoot.Position).Magnitude
				if distance<bestDistance then
					bestDistance=distance
					best=player
				end
			end
		end
	end
	return best
end

local function refreshTarget(player)
	if not player or not validTarget(player) then
		return false
	end
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	targetPlayer=player
	targetCharacter=character
	targetRoot=root
	if character:GetAttribute("InVehicle")==true then
		targetVehicle=targetVehicleForPlayer(player)
		if targetVehicle and isSpecialVehicle(targetVehicle) then
			return false
		end
	else
		targetVehicle=nil
	end
	return true
end

local function equipHandcuffs()
	for _,item in pairs(invSys.getInventoryItemsFor(LocalPlayer)) do
		if item.obj and item.obj.Name=="Handcuffs" then
			local ok=pcall(function()
				item:AttemptSetEquipped(true)
			end)
			if ok then
				return true
			end
		end
	end
	return false
end

local function equipHandcuffsRetry(token)
	local started=os.clock()
	while tokenValid(token) and os.clock()-started<3 do
		if equipHandcuffs() then
			return true
		end
		task.wait(0.1)
	end
	return false
end

local function unmountLocal(token)
	if not tokenValid(token) then
		return false
	end
	for _=1,8 do
		if isActuallyOutsideVehicle() then
			return true
		end
		pcall(function()
			VirtualInputManager:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
			VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
		end)
		task.wait(0.1)
	end
	return isActuallyOutsideVehicle()
end

local function discoverAttemptArrest()
	if type(getgc)~="function" or type(islclosure)~="function" or type(getinfo)~="function" then
		return nil
	end
	local attemptArrest
	local ok,objects=pcall(function()
		return getgc(true)
	end)
	if not ok or type(objects)~="table" then
		return nil
	end
	for _,v in pairs(objects) do
		if type(v)=="function" and islclosure(v) then
			pcall(function()
				if tostring(getinfo(v).name)=="AttemptArrest" then
					attemptArrest=v
				end
			end)
			if attemptArrest then
				break
			end
		end
	end
	return attemptArrest
end

local function getArrestFunction()
	local started=os.clock()
	while os.clock()-started<3 do
		local fn=discoverAttemptArrest()
		if fn then
			return fn
		end
		task.wait(0.1)
	end
	return nil
end

local function targetDistance()
	if not currentRoot or not targetRoot or not targetRoot.Parent then
		return math.huge
	end
	return (currentRoot.Position-targetRoot.Position).Magnitude
end

local function targetTpStep(token)
	if not tokenValid(token) or not targetPlayer then
		return false
	end
	if not refreshTarget(targetPlayer) then
		return false
	end
	if not targetRoot or not targetRoot.Parent then
		return false
	end
	local distance=targetDistance()
	if distance>Config.TargetLockDistance then
		clearPhysicsRoot()
		return false
	end
	pcall(function()
		sethiddenproperty(currentRoot,"PhysicsRepRootPart",targetRoot)
	end)
	targetPhysicsRoot=targetRoot
	currentRoot.CFrame=targetRoot.CFrame*Config.TargetTpOffset
	return true
end

local function approachTarget(token)
	while tokenValid(token) and targetPlayer do
		if not refreshTarget(targetPlayer) then
			return false
		end
		local character=targetCharacter
		if not character or not targetRoot then
			return false
		end
		if character:GetAttribute("InVehicle")==true then
			targetVehicle=targetVehicleForPlayer(targetPlayer)
			if targetVehicle and isSpecialVehicle(targetVehicle) then
				return false
			end
		else
			targetVehicle=nil
		end
		local distance=targetDistance()
		if distance<=Config.TargetLockDistance then
			if not targetTpStep(token) then
				return false
			end
		else
			clearPhysicsRoot()
			if not flyToward(targetRoot.Position,Config.TargetApproachSpeed,token) then
				if not tokenValid(token) then
					return false
				end
			end
			if distance<Config.TargetLockDistance+2 then
				task.wait()
			else
				task.wait()
			end
		end
	end
	return false
end

local function findTargetEjectSpec(vehicle)
	if not vehicle or not vehicle.Parent then
		return nil
	end
	local seat=getSeat(vehicle)
	if not seat then
		return nil
	end
	local specs=UI and UI.CircleAction and UI.CircleAction.Specs
	if type(specs)~="table" then
		return nil
	end
	for _,spec in pairs(specs) do
		if type(spec)=="table" and type(spec.Callback)=="function" and spec.Part then
			if spec.Part==seat or spec.Part:IsDescendantOf(vehicle) then
				return spec
			end
		end
	end
	return nil
end

local function ejectTargetFromVehicle(vehicle)
	local spec=findTargetEjectSpec(vehicle)
	if not spec then
		return false
	end
	return pcall(function()
		spec:Callback(true)
	end)
end

local function tirePop(token)
	if not tokenValid(token) or not targetPlayer then
		return false
	end
	if not refreshTarget(targetPlayer) then
		return false
	end
	targetVehicle=targetVehicleForPlayer(targetPlayer)
	if not targetVehicle or isSpecialVehicle(targetVehicle) then
		return false
	end
	local initialPop=targetVehicle:GetAttribute("VehicleTiresLastPop")
	while tokenValid(token) and targetPlayer do
		if not refreshTarget(targetPlayer) then
			return false
		end
		if not targetCharacter or not targetRoot then
			return false
		end
		if targetCharacter:GetAttribute("InVehicle")~=true then
			return true
		end
		targetVehicle=targetVehicleForPlayer(targetPlayer)
		if not targetVehicle then
			return false
		end
		if isSpecialVehicle(targetVehicle) then
			return false
		end
		if targetVehicle:GetAttribute("VehicleTiresLastPop")~=initialPop then
			return true
		end
		if (currentRoot.Position-targetRoot.Position).Magnitude>Config.TargetEngageDistance+30 then
			if not flyToward(targetRoot.Position,Config.TargetApproachSpeed,token) then
				return false
			end
		else
			local bv,bg=getFlightObjects()
			if bv then
				bv.Velocity=Vector3.zero
			end
			if bg and targetRoot then
				faceVelocity(targetRoot.Position-currentRoot.Position)
			end
			pcall(function()
				sethiddenproperty(currentRoot,"PhysicsRepRootPart",targetRoot)
			end)
			currentRoot.CFrame=targetRoot.CFrame*Config.TargetTpOffset
			clearPhysicsRoot()
		end
		task.wait(Config.TirePopCheckDelay)
	end
	return false
end

local function postVehicleTargetPursuit(token)
	while tokenValid(token) and targetPlayer do
		if not refreshTarget(targetPlayer) then
			return false
		end
		if not targetRoot then
			return false
		end
		if targetCharacter:GetAttribute("InVehicle")==true then
			targetVehicle=targetVehicleForPlayer(targetPlayer)
			if targetVehicle and isSpecialVehicle(targetVehicle) then
				return false
			end
			if targetVehicle then
				ejectTargetFromVehicle(targetVehicle)
			end
		else
			targetVehicle=nil
		end
		local distance=targetDistance()
		if distance<=Config.TargetLockDistance then
			if not targetTpStep(token) then
				return false
			end
		else
			clearPhysicsRoot()
			flyToward(targetRoot.Position,Config.TargetApproachSpeed,token)
		end
		task.wait()
	end
	return false
end

local function attemptArrestTarget(token)
	if not tokenValid(token) or not targetPlayer or not targetCharacter then
		return false
	end
	if not isActuallyOutsideVehicle() then
		return false
	end
	if not equipHandcuffsRetry(token) then
		return false
	end
	local arrest=getArrestFunction()
	if not arrest then
		return false
	end
	local started=os.clock()
	while tokenValid(token) and os.clock()-started<Config.ArrestTimeout do
		if not refreshTarget(targetPlayer) then
			return false
		end
		if targetCharacter:GetAttribute("InVehicle")==true then
			targetVehicle=targetVehicleForPlayer(targetPlayer)
			if targetVehicle and isSpecialVehicle(targetVehicle) then
				return false
			end
			if targetVehicle then
				ejectTargetFromVehicle(targetVehicle)
			end
		end
		if targetCharacter:GetAttribute("HasHandcuffs")==true then
			return true
		end
		pcall(function()
			arrest(targetPlayer)
		end)
		task.wait(0.1)
	end
	return targetCharacter and targetCharacter:GetAttribute("HasHandcuffs")==true
end

local function targetApproachAndArrest(token)
	if not targetPlayer then
		return false
	end
	if not refreshTarget(targetPlayer) then
		return false
	end
	if targetCharacter:GetAttribute("InVehicle")==true then
		targetVehicle=targetVehicleForPlayer(targetPlayer)
		if not targetVehicle or isSpecialVehicle(targetVehicle) then
			return false
		end
		while tokenValid(token) and targetPlayer do
			if not refreshTarget(targetPlayer) then
				return false
			end
			if targetCharacter:GetAttribute("InVehicle")~=true then
				break
			end
			targetVehicle=targetVehicleForPlayer(targetPlayer)
			if targetVehicle and isSpecialVehicle(targetVehicle) then
				return false
			end
			if targetRoot and (currentRoot.Position-targetRoot.Position).Magnitude>Config.TargetEngageDistance then
				flyToward(targetRoot.Position,Config.TargetApproachSpeed,token)
			else
				local bv=getFlightObjects()
				if bv then
					bv.Velocity=Vector3.zero
				end
			end
			targetVehicle=targetVehicleForPlayer(targetPlayer)
			if targetVehicle then
				local initial=targetVehicle:GetAttribute("VehicleTiresLastPop")
				if initial~=nil then
					local result=tirePop(token)
					if not result then
						if not targetPlayer or not validTarget(targetPlayer) then
							return false
						end
					end
					break
				end
			else
				break
			end
			task.wait(Config.TirePopCheckDelay)
		end
	end
	lastExitedVehicle=currentVehicle
	if not unmountLocal(token) then
		return false
	end
	equipHandcuffsRetry(token)
	return postVehicleTargetPursuit(token) or attemptArrestTarget(token)
end

local function returnToSavedVehicle(token)
	phase="ReturnVehicle"
	if not tokenValid(token) then
		return false
	end
	clearPhysicsRoot()
	if not ascendBy(Config.ReturnHeight,token) then
		return false
	end
	local saved=lastExitedVehicle
	if saved and saved.Parent and vehicleUsable(saved) then
		local distance=(getSeat(saved).Position-currentRoot.Position).Magnitude
		if distance<=Config.FallbackDistance then
			while tokenValid(token) and saved.Parent and vehicleUsable(saved) do
				local seat=getSeat(saved)
				if not seat then
					break
				end
				local horizontal=Vector3.new(seat.Position.X,currentRoot.Position.Y,seat.Position.Z)
				if (currentRoot.Position-horizontal).Magnitude>5 then
					flyToward(horizontal,Config.AscendSpeed,token)
				else
					if not ascendToHeight(seat.Position.Y+8,token) then
						return false
					end
					for _=1,8 do
						if isActuallyInVehicle() then
							currentVehicle=refreshRememberedCar() or saved
							return true
						end
						triggerVehicleSeat(saved)
						task.wait(0.15)
					end
					local actual=verifyLocalVehicle(saved)
					if actual then
						currentVehicle=actual
						return true
					end
					break
				end
				task.wait()
			end
		end
	end
	local alternate=selectNearestLocalVehicle(math.huge)
	if alternate then
		local seat=getSeat(alternate)
		if seat then
			while tokenValid(token) and (currentRoot.Position-seat.Position).Magnitude>8 do
				flyToward(Vector3.new(seat.Position.X,currentRoot.Position.Y,seat.Position.Z),Config.AscendSpeed,token)
				task.wait()
			end
			if tokenValid(token) then
				ascendToHeight(seat.Position.Y+8,token)
				local actual=enterVehicle(alternate,token,4)
				if actual then
					currentVehicle=actual
					return true
				end
			end
		end
	end
	return false
end

local function safeSpawnPosition(token)
	if not tokenValid(token) then
		return false
	end
	local origin=currentRoot.Position
	local direction=Vector3.new(math.random(-100,100),0,math.random(-100,100))
	if direction.Magnitude<1 then
		direction=Vector3.new(1,0,0)
	end
	direction=direction.Unit*Config.FallbackAwayDistance
	local destination=origin+direction
	if targetRoot and targetRoot.Parent and (destination-targetRoot.Position).Magnitude<Config.FallbackAwayDistance then
		destination=origin+Vector3.new(Config.FallbackAwayDistance,0,0)
	end
	while tokenValid(token) and (currentRoot.Position-destination).Magnitude>10 do
		flyToward(Vector3.new(destination.X,currentRoot.Position.Y,destination.Z),Config.AscendSpeed,token)
		task.wait()
	end
	if not tokenValid(token) then
		return false
	end
	local nearest=findNearestTarget()
	if nearest and nearest.Character and nearest.Character:FindFirstChild("HumanoidRootPart") then
		if (currentRoot.Position-nearest.Character.HumanoidRootPart.Position).Magnitude<Config.EnemySpawnClearance then
			local away=(currentRoot.Position-nearest.Character.HumanoidRootPart.Position)
			if away.Magnitude<1 then
				away=Vector3.new(1,0,0)
			end
			local safe=currentRoot.Position+away.Unit*Config.EnemySpawnClearance
			while tokenValid(token) and (currentRoot.Position-safe).Magnitude>10 do
				flyToward(Vector3.new(safe.X,currentRoot.Position.Y,safe.Z),Config.AscendSpeed,token)
				task.wait()
			end
		end
	end
	local rayParams=RaycastParams.new()
	rayParams.FilterType=Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances={currentCharacter}
	local result=Workspace:Raycast(currentRoot.Position,Vector3.new(0,-1000,0),rayParams)
	if not result then
		return false
	end
	local groundY=result.Position.Y+5
	while tokenValid(token) and math.abs(currentRoot.Position.Y-groundY)>4 do
		if obstacleAhead(Vector3.new(0,-1,0)) then
			if currentHumanoid then
				currentHumanoid.Health=0
			end
			return false
		end
		flyVerticalTo(groundY,Config.DescendSpeed,token)
		task.wait()
	end
	return tokenValid(token)
end

local function spawnFallbackVehicle(token)
	if not safeSpawnPosition(token) then
		return false
	end
	local spawnRemote=ReplicatedStorage:FindFirstChild("GarageSpawnVehicle",true)
	if not spawnRemote then
		return false
	end
	local spawned=false
	pcall(function()
		spawnRemote:FireServer("Chassis","Camaro")
		spawned=true
	end)
	if not spawned then
		pcall(function()
			spawnRemote:FireServer("Chassis","Jeep")
			spawned=true
		end)
	end
	if not spawned then
		return false
	end
	local started=os.clock()
	while tokenValid(token) and os.clock()-started<6 do
		local car=refreshRememberedCar()
		if car and isVehicleModel(car) then
			local actual=enterVehicle(car,token,3)
			if actual then
				currentVehicle=actual
				return true
			end
		end
		task.wait(0.2)
	end
	pcall(function()
		spawnRemote:FireServer("Chassis","Jeep")
	end)
	started=os.clock()
	while tokenValid(token) and os.clock()-started<5 do
		local car=refreshRememberedCar()
		if car and isVehicleModel(car) then
			local actual=enterVehicle(car,token,2)
			if actual then
				currentVehicle=actual
				return true
			end
		end
		task.wait(0.2)
	end
	return false
end

local function recoverVehicle(token)
	if not tokenValid(token) then
		return false
	end
	if returnToSavedVehicle(token) then
		return true
	end
	return spawnFallbackVehicle(token)
end

local function targetCruise(token,player)
	phase="TargetCruise"
	targetPlayer=player
	if not refreshTarget(player) then
		return false
	end
	while tokenValid(token) and targetPlayer do
		if not refreshTarget(targetPlayer) then
			return false
		end
		if targetCharacter:GetAttribute("InVehicle")==true then
			targetVehicle=targetVehicleForPlayer(targetPlayer)
			if targetVehicle and isSpecialVehicle(targetVehicle) then
				return false
			end
		else
			targetVehicle=nil
		end
		local desiredY=targetRoot.Position.Y+Config.TargetSearchHeight
		local horizontal=Vector3.new(targetRoot.Position.X,currentRoot.Position.Y,targetRoot.Position.Z)
		local horizontalDistance=(currentRoot.Position-horizontal).Magnitude
		if horizontalDistance>10 then
			if obstacleAhead((horizontal-currentRoot.Position)) then
				if currentHumanoid then
					currentHumanoid.Health=0
				end
				return false
			end
			flyToward(horizontal,Config.AscendSpeed,token)
		else
			local deltaY=desiredY-currentRoot.Position.Y
			if math.abs(deltaY)>8 then
				if not safeVerticalMove(desiredY,deltaY>0 and Config.AscendSpeed or Config.DescendSpeed,token) then
					return false
				end
			else
				break
			end
		end
		task.wait()
	end
	while tokenValid(token) and targetPlayer do
		if not refreshTarget(targetPlayer) then
			return false
		end
		if targetCharacter:GetAttribute("InVehicle")==true then
			targetVehicle=targetVehicleForPlayer(targetPlayer)
			if targetVehicle and isSpecialVehicle(targetVehicle) then
				return false
			end
		end
		local targetY=targetRoot.Position.Y
		local engageY=targetY+(targetCharacter:GetAttribute("InVehicle")==true and Config.TargetEngageDistance or 6)
		if currentRoot.Position.Y>engageY+3 then
			if obstacleAhead(Vector3.new(0,-1,0)) then
				if currentHumanoid then
					currentHumanoid.Health=0
				end
				return false
			end
			flyVerticalTo(engageY,Config.DescendSpeed,token)
		else
			break
		end
		task.wait()
	end
	return targetApproachAndArrest(token)
end

local function resetBlacklistForPrisoners()
	for player in pairs(arrestedBlacklist) do
		if not player.Parent then
			arrestedBlacklist[player]=nil
		elseif player.Team and player.Team.Name=="Criminal" then
			arrestedBlacklist[player]=nil
		end
	end
end

local function runCycle()
	if stateRunning then
		return
	end
	stateRunning=true
	invalidate()
	local token=cycleId
	currentCharacter,currentHumanoid,currentRoot=getCharacter()
	if not currentCharacter or not currentHumanoid or not currentRoot then
		stateRunning=false
		return
	end
	task.wait(0.5)
	if not tokenValid(token) then
		return
	end
	if not runPhase1(token) then
		return
	end
	if not tokenValid(token) then
		return
	end
	phase="Phase2"
	local entered=findAndEnterLocalVehicle(token)
	if not entered then
		stateRunning=false
		return
	end
	currentVehicle=entered
	rememberedCar=entered
	if not isActuallyInVehicle() then
		stateRunning=false
		return
	end
	phase="Phase3"
	local initialHeight=currentRoot.Position.Y+Config.TargetSearchHeight
	if not ascendToHeight(initialHeight,token) then
		return
	end
	while tokenValid(token) do
		resetBlacklistForPrisoners()
		phase="FindTarget"
		local target=findNearestTarget()
		if not target then
			task.wait(0.5)
			continue
		end
		targetPlayer=target
		if not targetCruise(token,target) then
			cleanupTarget()
			if tokenValid(token) then
				phase="Recover"
				if not currentVehicle or not isActuallyInVehicle() then
					if not recoverVehicle(token) then
						return
					end
				end
				if isActuallyInVehicle() then
					ascendToHeight(currentRoot.Position.Y+Config.TargetSearchHeight,token)
				end
			end
		else
			if targetCharacter and targetCharacter:GetAttribute("HasHandcuffs")==true then
				print("[HANDCUFFED]",targetPlayer.Name)
				arrestedBlacklist[targetPlayer]=true
				local arrestedTarget=targetPlayer
				cleanupTarget()
				phase="Return"
				local returned=recoverVehicle(token)
				if not returned then
					return
				end
				if not isActuallyInVehicle() then
					return
				end
				phase="NextTarget"
				ascendToHeight(currentRoot.Position.Y+Config.TargetSearchHeight,token)
				if arrestedTarget and arrestedTarget.Team and arrestedTarget.Team.Name=="Criminal" then
					arrestedBlacklist[arrestedTarget]=true
				end
			else
				cleanupTarget()
			end
		end
		task.wait()
	end
end

local function stopOnCharacterLoss()
	stateRunning=false
	invalidate()
	destroyFlight()
	cleanupTarget()
	currentVehicle=nil
	lastExitedVehicle=nil
	targetVehicle=nil
	targetPlayer=nil
	targetCharacter=nil
	targetRoot=nil
	Phase1Complete=false
	InitialStationPhase=false
	phase="Dead"
	currentCharacter=nil
	currentHumanoid=nil
	currentRoot=nil
end

local function bindCharacter(character)
	if characterRemovingConnection then
		characterRemovingConnection:Disconnect()
		characterRemovingConnection=nil
	end
	currentCharacter=character
	currentHumanoid=nil
	currentRoot=nil
	stateRunning=false
	invalidate()
	cleanupCycle()
	currentCharacter=character
	currentHumanoid=character:WaitForChild("Humanoid",10)
	currentRoot=character:WaitForChild("HumanoidRootPart",10)
	if not currentHumanoid or not currentRoot then
		return
	end
	characterRemovingConnection=currentHumanoid.Died:Connect(function()
		stopOnCharacterLoss()
	end)
	task.spawn(function()
		task.wait(0.5)
		if currentCharacter==character and character.Parent and currentHumanoid and currentHumanoid.Health>0 then
			runCycle()
		end
	end)
end

characterAddedConnection=LocalPlayer.CharacterAdded:Connect(function(character)
	bindCharacter(character)
end)

if LocalPlayer.Character then
	bindCharacter(LocalPlayer.Character)
end
