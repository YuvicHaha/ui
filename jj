local function tokenValid(token)
	return token==cycleId and stateRunning and currentCharacter and currentCharacter.Parent and currentHumanoid and currentHumanoid.Parent and currentRoot and currentRoot.Parent
end

local function invalidate()
	cycleId+=1
end

local function getCharacter()
	local character=LocalPlayer.Character
	if not character or not character.Parent then
		return nil,nil,nil
	end
	local humanoid=character:FindFirstChildOfClass("Humanoid")
	local root=character:FindFirstChild("HumanoidRootPart")
	return character,humanoid,root
end

local function clearPhysicsRoot()
	if currentRoot and currentRoot.Parent then
		pcall(function()
			sethiddenproperty(currentRoot,"PhysicsRepRootPart",nil)
		end)
	end
	targetPhysicsRoot=nil
end

local function destroyFlight()
	if flightConnection then
		pcall(function()
			flightConnection:Disconnect()
		end)
		flightConnection=nil
	end
	if bodyVelocity then
		pcall(function()
			bodyVelocity:Destroy()
		end)
		bodyVelocity=nil
	end
	if bodyGyro then
		pcall(function()
			bodyGyro:Destroy()
		end)
		bodyGyro=nil
	end
	clearPhysicsRoot()
end

local function cleanupTarget()
	clearPhysicsRoot()
	targetVehicle=nil
	targetPlayer=nil
	targetCharacter=nil
	targetRoot=nil
end

local function cleanupCycle()
	destroyFlight()
	cleanupTarget()
	currentVehicle=nil
	lastExitedVehicle=nil
	Phase1Complete=false
	InitialStationPhase=false
	phase="Idle"
end

local function getFlightObjects()
	if not currentRoot or not currentRoot.Parent then
		return nil,nil
	end
	if not bodyVelocity or not bodyVelocity.Parent then
		bodyVelocity=Instance.new("BodyVelocity")
		bodyVelocity.Name="PoliceAutomationVelocity"
		bodyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
		bodyVelocity.P=10000
		bodyVelocity.Velocity=Vector3.zero
		bodyVelocity.Parent=currentRoot
	end
	if not bodyGyro or not bodyGyro.Parent then
		bodyGyro=Instance.new("BodyGyro")
		bodyGyro.Name="PoliceAutomationGyro"
		bodyGyro.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
		bodyGyro.P=50000
		bodyGyro.D=1000
		bodyGyro.CFrame=currentRoot.CFrame
		bodyGyro.Parent=currentRoot
	end
	return bodyVelocity,bodyGyro
end

local function faceVelocity(direction)
	if not bodyGyro or not bodyGyro.Parent or direction.Magnitude<0.01 then
		return
	end
	local look=direction.Unit
	bodyGyro.CFrame=CFrame.lookAt(currentRoot.Position,currentRoot.Position+look)
end

local function flyToward(position,speed,token)
	if not tokenValid(token) then
		return false
	end
	local bv,bg=getFlightObjects()
	if not bv or not bg then
		return false
	end
	local delta=position-currentRoot.Position
	if delta.Magnitude<0.5 then
		bv.Velocity=Vector3.zero
		return true
	end
	bv.Velocity=delta.Unit*speed
	faceVelocity(delta)
	return false
end

local function flyVerticalTo(y,speed,token)
	if not tokenValid(token) then
		return false
	end
	local target=Vector3.new(currentRoot.Position.X,y,currentRoot.Position.Z)
	local delta=target-currentRoot.Position
	if math.abs(delta.Y)<2 then
		local bv=getFlightObjects()
		if bv then
			bv.Velocity=Vector3.zero
		end
		return true
	end
	local bv,bg=getFlightObjects()
	if not bv or not bg then
		return false
	end
	local direction=Vector3.new(0,delta.Y,0)
	bv.Velocity=direction.Unit*speed
	faceVelocity(direction)
	return false
end

local function obstacleAhead(direction)
	if not currentRoot or not currentRoot.Parent then
		return true
	end
	if direction.Magnitude<0.01 then
		return false
	end
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	local ignore={currentCharacter}
	if currentVehicle and currentVehicle.Parent then
		table.insert(ignore,currentVehicle)
	end
	params.FilterDescendantsInstances=ignore
	local result=Workspace:Raycast(currentRoot.Position,direction.Unit*Config.ObstacleCheckDistance,params)
	return result~=nil
end

local function safeVerticalMove(y,speed,token)
	if not tokenValid(token) then
		return false
	end
	local deltaY=y-currentRoot.Position.Y
	if math.abs(deltaY)<2 then
		return true
	end
	local direction=Vector3.new(0,deltaY>0 and 1 or -1,0)
	if obstacleAhead(direction) then
		if currentHumanoid then
			currentHumanoid.Health=0
		end
		return false
	end
	return flyVerticalTo(y,speed,token)
end

local function isVehicleModel(model)
	if not model or not model:IsA("Model") then
		return false
	end
	local name=string.lower(model.Name)
	return string.find(name,"camaro",1,true)~=nil or string.find(name,"jeep",1,true)~=nil
end

local function isSpecialVehicle(model)
	if not model then
		return false
	end
	local name=string.lower(model.Name)
	for _,word in ipairs({"heli","ufo","blackhawk","drone","blimp"}) do
		if string.find(name,word,1,true) then
			return true
		end
	end
	return false
end

local function getSeat(vehicle)
	if not vehicle or not vehicle.Parent then
		return nil
	end
	local seat=vehicle:FindFirstChild("Seat")
	if seat and seat:IsA("BasePart") then
		return seat
	end
	for _,d in ipairs(vehicle:GetDescendants()) do
		if (d:IsA("VehicleSeat") or d:IsA("Seat")) and d.Name=="Seat" then
			return d
		end
	end
	for _,d in ipairs(vehicle:GetDescendants()) do
		if d:IsA("VehicleSeat") or d:IsA("Seat") then
			return d
		end
	end
	return nil
end

local function getLocalVehicle()
	local ok,m=pcall(vehicleUtils.GetLocalVehicleModel)
	if not ok or not m or m=="" or m==false then
		return nil
	end
	if typeof(m)=="Instance" then
		return m
	end
	return Workspace:FindFirstChild(tostring(m),true)
end

local function refreshRememberedCar()
	local car=getLocalVehicle()
	if car and car~=rememberedCar then
		rememberedCar=car
	end
	return car
end

getgenv().GetMyCar=function()
	return rememberedCar
end

