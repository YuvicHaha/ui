    end
    if playerCount>=Config.ServerHopMinPlayers and playerCount<=Config.ServerHopMaxPlayers and criminalCount<Config.ServerHopCriminalLimit then
        ServerHop("TOO FEW CRIMINALS")
        return true
    end
    return false
end
