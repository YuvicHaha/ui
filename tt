local function EjectNearestVehicleUser(targetRoot)
    local targetChar=targetRoot and targetRoot.Parent
    local targetVehicle=nil
    if targetChar and targetChar:GetAttribute("InVehicle") then
        local vehiclesDir=workspace:FindFirstChild("Vehicles")
        if vehiclesDir then
            for _,v in pairs(vehiclesDir:GetChildren()) do
                local seat=v:FindFirstChild("Seat") or v:FindFirstChild("VehicleSeat") or v:FindFirstChildWhichIsA("BasePart",true)
                if seat and (seat.Position-targetRoot.Position).Magnitude<15 then
                    targetVehicle=v
                    break
                end
            end
        end
    end
    if not targetVehicle then
        return
    end
    local uiModule=ReplicatedStorage:FindFirstChild("Module",true) and require(ReplicatedStorage.Module:FindFirstChild("UI",true) or ReplicatedStorage.Module)
    if uiModule and uiModule.CircleAction and uiModule.CircleAction.Specs then
        for _,spec in pairs(uiModule.CircleAction.Specs) do
            local isMatch=false
            if spec.Part and (targetVehicle:IsAncestorOf(spec.Part) or spec.Part:IsDescendantOf(targetVehicle)) then
                isMatch=true
            elseif spec.Text and (spec.Text:lower():find("eject") or spec.Text:lower():find("passenger")) then
                isMatch=true
            end
            if isMatch then
                pcall(function()
                    spec:Callback(true)
                end)
                return
            end
        end
    end
end
