local function IsObstacleAboveAt(origin,distance,vehicle)
    if not origin then return true end
    local rayParams=RaycastParams.new()
    rayParams.FilterType=Enum.RaycastFilterType.Exclude
    local ignoreList={LocalPlayer.Character}
    if vehicle and vehicle.Parent then table.insert(ignoreList,vehicle) end
    rayParams.FilterDescendantsInstances=ignoreList
    rayParams.IgnoreWater=true
    local result=workspace:Raycast(origin,Vector3.new(0,distance or Config.CeilingCheckRayDistance,0),rayParams)
    return result and result.Instance and result.Instance.CanCollide or false
end
local function IsObstacleAbove(rootPart,distance,vehicle)
    return not rootPart or not rootPart.Parent or IsObstacleAboveAt(rootPart.Position,distance,vehicle)
end
local function GetVehicleSeat(vehicle)
    if not vehicle or not vehicle.Parent then return nil end
    return vehicle:FindFirstChild("Seat") or vehicle:FindFirstChild("VehicleSeat") or vehicle:FindFirstChildWhichIsA("VehicleSeat",true) or vehicle:FindFirstChildWhichIsA("Seat",true)
end
local function GetVehicleFromSeat(seat)
    if not seat then return nil end
    local vehicles=workspace:FindFirstChild("Vehicles")
    local node=seat
    while node and node~=workspace do
        if vehicles and node.Parent==vehicles then return node end
        node=node.Parent
    end
    return nil
end
local function IsVehicleAvailable(vehicle)
    if not vehicle or not vehicle.Parent then return false end
    local vehicles=workspace:FindFirstChild("Vehicles")
    if vehicles and not vehicle:IsDescendantOf(vehicles) then return false end
    local seat=GetVehicleSeat(vehicle)
    if not seat or not seat.Parent then return false end
    if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
        if seat.Occupant then return false end
    end
    if vehicle:GetAttribute("Destroyed")==true then return false end
    local driver=vehicle:FindFirstChild("Driver",true)
    if driver and driver:IsA("ObjectValue") and driver.Value and driver.Value~=LocalPlayer then return false end
    return true
end
local function GetTargetVehicle(targetRoot)
    if not targetRoot or not targetRoot.Parent then return nil end
    local targetChar=targetRoot.Parent
    if not targetChar:GetAttribute("InVehicle") then return nil end
    local vehicles=workspace:FindFirstChild("Vehicles")
    if not vehicles then return nil end
    for _,vehicle in ipairs(vehicles:GetChildren()) do
        local seat=GetVehicleSeat(vehicle)
        if seat and (seat.Position-targetRoot.Position).Magnitude<=15 then return vehicle end
    end
    return nil
end
local function IsTargetVehicle(vehicle)
    local targetVehicle=GetTargetVehicle(targetRoot)
    return vehicle and targetVehicle and vehicle==targetVehicle
end
local function IsVehicleApproachBlocked(vehicle,rootPart,flyHeight)
    if not vehicle or not rootPart then return true end
    local seat=GetVehicleSeat(vehicle)
    if not seat then return true end
    local height=flyHeight or Config.CarFlyHeight
    local function blockedAt(origin)
        local topY=seat.Position.Y+height
        if topY<=origin.Y then return false end
        return IsObstacleAboveAt(origin,math.min(Config.CeilingCheckRayDistance,topY-origin.Y),vehicle)
    end
    return blockedAt(rootPart.Position) or blockedAt(seat.Position+Vector3.new(0,1.5,0))
end
local function FindExpectedVehicle(position)
    local vehicles=workspace:FindFirstChild("Vehicles")
    if not vehicles or not position then return nil end
    local best,bestDist=nil,math.huge
    for _,vehicle in ipairs(vehicles:GetChildren()) do
        if IsVehicleAvailable(vehicle) and not IsTargetVehicle(vehicle) then
            local seat=GetVehicleSeat(vehicle)
            local d=seat and (seat.Position-position).Magnitude or math.huge
            if d<=Config.VehicleEnterRadius and d<bestDist then best,bestDist=vehicle,d end
        end
    end
    return best
end
