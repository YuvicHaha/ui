local function FlyPlayerTo(rootPart,targetPos,stopDist,speed,generation,checkOverhead)
    if not SessionValid(generation,sessionCharacter,rootPart) then return false end
    if not rootPart or not rootPart.Parent then return false end
    DestroyFlightObjects(rootPart)
    local attachment=Instance.new("Attachment",rootPart)
    attachment.Name="ExecFlyAttachment"
    local linearVelocity=Instance.new("LinearVelocity",rootPart)
    linearVelocity.Name="ExecFlyVelocity"
    linearVelocity.Attachment0=attachment
    linearVelocity.RelativeTo=Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce=math.huge
    linearVelocity.VectorVelocity=Vector3.zero
    linearVelocity.Enabled=true
    local elapsed=0
    while SessionValid(generation,sessionCharacter,rootPart) do
        if CheckLagback(rootPart,generation) then break end
        if checkOverhead and targetPos.Y>rootPart.Position.Y and IsObstacleAbove(rootPart,math.min(Config.CeilingCheckRayDistance,targetPos.Y-rootPart.Position.Y),currentVehicle) then
            RequestCharacterReset("OVERHEAD BLOCKED",generation)
            break
        end
        local delta=targetPos-rootPart.Position
        local dist=delta.Magnitude
        if dist<=(stopDist or 10) then
            pcall(function() linearVelocity:Destroy();attachment:Destroy() end)
            return true
        end
        linearVelocity.VectorVelocity=delta.Unit*(speed or Config.PlayerFlySpeed)
        elapsed+=task.wait()
        if elapsed>20 then
            RequestCharacterReset("FLIGHT TIMEOUT",generation)
            break
        end
    end
    pcall(function() linearVelocity:Destroy();attachment:Destroy() end)
    return false
end
local function ApproachAndEnterVehicle(vehicle,generation,char,rootPart,humanoid,flyHeight)
    if not SessionValid(generation,char,rootPart) or not IsVehicleAvailable(vehicle) then return false end
    phaseState="VEHICLE_APPROACH"
    currentVehicle=vehicle
    movementExpected=true
    antiStuckPaused=false
    local seat=GetVehicleSeat(vehicle)
    if not seat then return false end
    local effectiveHeight=flyHeight or Config.CarFlyHeight
    if IsVehicleApproachBlocked(vehicle,rootPart,effectiveHeight) then
        RequestCharacterReset("VEHICLE APPROACH CEILING BLOCKED",generation)
        return false
    end
    local flyY=seat.Position.Y+effectiveHeight
    if flyY>rootPart.Position.Y and IsObstacleAbove(rootPart,math.min(Config.CeilingCheckRayDistance,flyY-rootPart.Position.Y),vehicle) then
        RequestCharacterReset("VEHICLE ASCENT BLOCKED",generation)
        return false
    end
    if not FlyPlayerTo(rootPart,Vector3.new(rootPart.Position.X,flyY,rootPart.Position.Z),10,Config.PlayerFlySpeed,generation,true) then return false end
    if not FlyPlayerTo(rootPart,Vector3.new(seat.Position.X,flyY,seat.Position.Z),10,Config.PlayerFlySpeed,generation,false) then return false end
    phaseState="VEHICLE_APPROACH_HOVER"
    movementExpected=false
    antiStuckPaused=true
    task.wait(0.15)
    if not SessionValid(generation,char,rootPart) or not IsVehicleAvailable(vehicle) then return false end
    phaseState="VEHICLE_DESCEND"
    movementExpected=true
    antiStuckPaused=false
    if not FlyPlayerTo(rootPart,seat.Position+Vector3.new(0,3,0),12,Config.PlayerFlySpeed,generation,false) then return false end
    phaseState="VEHICLE_ENTRY"
    movementExpected=false
    antiStuckPaused=true
    if not IsVehicleAvailable(vehicle) then return false end
    EnterVehicleAsDriver(vehicle)
    local seated=WaitForSeated(char,humanoid,Config.VehicleEnterDelay+1.5)
    if seated then rememberedCar=vehicle;currentVehicle=vehicle;return true end
    return false
end
