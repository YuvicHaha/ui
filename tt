local function GetTerrainObstacleHeight(rootPart,targetRoot)
    local terrain=workspace:FindFirstChildOfClass("Terrain")
    if not terrain or not rootPart or not targetRoot then return nil end
    local direction=targetRoot.Position-rootPart.Position
    local horizontal=Vector3.new(direction.X,0,direction.Z)
    if horizontal.Magnitude<1 then return nil end
    local forward=horizontal.Unit
    local maxDistance=math.min(horizontal.Magnitude,250)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances={terrain}
    params.IgnoreWater=true
    local best=nil
    for _,distance in ipairs({80,150,220}) do
        if distance<=maxDistance then
            local center=rootPart.Position+forward*distance+Vector3.new(0,1000,0)
            local result=workspace:Raycast(center,Vector3.new(0,-2000,0),params)
            if result and result.Instance==terrain then
                best=(not best or result.Position.Y>best) and result.Position.Y or best
            end
        end
    end
    return best
end
local function ExecuteAutoArrestCycle(generation,char,rootPart,humanoid)
    if not SessionValid(generation,char,rootPart) then return false end
    if phaseState~="VEHICLE_ENTRY_COMPLETE" and phaseState~="TARGET_FOLLOW" and phaseState~="VEHICLE_RETURN" then return false end
    local inVehicle=char:GetAttribute("InVehicle") or humanoid.SeatPart~=nil
    if not inVehicle then
        phaseState="VEHICLE_RETURN"
        movementExpected=false
        antiStuckPaused=true
        local returnCar=lastCarExited
        if returnCar and IsTargetVehicle(returnCar) then
            print("[VEHICLE RETURN] Saved last-exit vehicle is now target vehicle; refusing target vehicle.")
            returnCar=nil
        end
        if returnCar and IsVehicleAvailable(returnCar) then
            local seat=GetVehicleSeat(returnCar)
            if seat and IsVehicleApproachBlocked(returnCar,rootPart,Config.PlayerReturnFlyHeight) then
                RequestCharacterReset("LAST EXIT VEHICLE CEILING BLOCKED",generation)
                return false
            end
            if seat and (rootPart.Position-seat.Position).Magnitude>100 then
                if ApproachAndEnterVehicle(returnCar,generation,char,rootPart,humanoid,Config.PlayerReturnFlyHeight) then phaseState="VEHICLE_ENTRY_COMPLETE";return true end
                return false
            elseif seat then
                if IsObstacleAboveAt(seat.Position+Vector3.new(0,1.5,0),math.min(Config.CeilingCheckRayDistance,Config.PlayerReturnFlyHeight),returnCar) then
                    RequestCharacterReset("LAST EXIT VEHICLE ENTRY CEILING BLOCKED",generation)
                    return false
                end
                EnterVehicleAsDriver(returnCar)
                if WaitForSeated(char,humanoid,1.5) then phaseState="VEHICLE_ENTRY_COMPLETE";return true end
            end
        end
        local fallback=FindNearestAvailableVehicle(rootPart.Position,Config.Phase1VehicleSearchRadius)
        if fallback then
            if IsVehicleApproachBlocked(fallback,rootPart,Config.PlayerReturnFlyHeight) then
                RequestCharacterReset("FALLBACK VEHICLE CEILING BLOCKED",generation)
                return false
            end
            if ApproachAndEnterVehicle(fallback,generation,char,rootPart,humanoid,Config.PlayerReturnFlyHeight) then phaseState="VEHICLE_ENTRY_COMPLETE";return true end
            return false
        end
        RequestCharacterReset("NO SAFE VEHICLE AVAILABLE",generation)
        return false
    end
    local vehicle=GetCurrentVehicle(humanoid)
    if vehicle then currentVehicle=vehicle end
    phaseState="TARGET_FOLLOW"
    movementExpected=false
    antiStuckPaused=true
    local checkPlr,checkRoot=getClosestCriminal(rootPart)
    if not checkRoot then task.wait(0.5);return true end
    currentTarget=checkPlr
    targetRoot=checkRoot
    local bodyGyro=Instance.new("BodyGyro",rootPart)
    bodyGyro.Name="ExecBodyGyro"
    bodyGyro.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
    bodyGyro.D=500
    bodyGyro.P=150000
    local bodyVelocity=Instance.new("BodyVelocity",rootPart)
    bodyVelocity.Name="ExecBodyVelocity"
    bodyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
    local seat=GetVehicleSeat(vehicle)
    local baseY=(seat and seat.Position.Y or rootPart.Position.Y)+Config.CarFlyHeight
    if rootPart.Position.Y<baseY then
        movementExpected=true
        antiStuckPaused=false
        if IsObstacleAbove(rootPart,math.min(Config.CeilingCheckRayDistance,baseY-rootPart.Position.Y),vehicle) then
            bodyVelocity:Destroy();bodyGyro:Destroy();RequestCharacterReset("TARGET FLIGHT CEILING",generation);return false
        end
        if not FlyPlayerTo(rootPart,Vector3.new(rootPart.Position.X,baseY,rootPart.Position.Z),10,Config.CarAscendSpeed,generation,true) then
            pcall(function() bodyVelocity:Destroy();bodyGyro:Destroy() end);return false
        end
    end
    phaseState="TARGET_FOLLOW"
    movementExpected=true
    antiStuckPaused=false
    while SessionValid(generation,char,rootPart) and isTargetValid(targetRoot) do
        local terrainHeight=GetTerrainObstacleHeight(rootPart,targetRoot)
        local desiredY=baseY
        if terrainHeight and terrainHeight+80>desiredY then desiredY=terrainHeight+80 end
        if desiredY>rootPart.Position.Y and IsObstacleAbove(rootPart,math.min(Config.CeilingCheckRayDistance,desiredY-rootPart.Position.Y),vehicle) then
            bodyVelocity:Destroy();bodyGyro:Destroy();RequestCharacterReset("TERRAIN ASCENT BLOCKED",generation);return false
        end
        local targetPos=Vector3.new(targetRoot.Position.X,desiredY,targetRoot.Position.Z)
        local horizontalTarget=Vector3.new(targetPos.X,rootPart.Position.Y,targetPos.Z)
        local distXZ=(horizontalTarget-rootPart.Position).Magnitude
        if distXZ>Config.CarCruiseDistanceThreshold then
            bodyVelocity.Velocity=(targetPos-rootPart.Position).Unit*Config.CarCruiseSpeed
            bodyGyro.CFrame=CFrame.lookAt(rootPart.Position,targetPos)
        else break end
        if CheckLagback(rootPart,generation) then bodyVelocity:Destroy();bodyGyro:Destroy();return false end
        task.wait()
    end
    if not SessionValid(generation,char,rootPart) or not isTargetValid(targetRoot) then
        bodyVelocity:Destroy();bodyGyro:Destroy();movementExpected=false;antiStuckPaused=true;return true
    end
    while SessionValid(generation,char,rootPart) and isTargetValid(targetRoot) do
        local targetPos=targetRoot.Position
        local dist=(rootPart.Position-targetPos).Magnitude
        if dist>Config.CarDescendDistanceThreshold then
            bodyVelocity.Velocity=(targetPos-rootPart.Position).Unit*Config.CarDescendSpeed
            bodyGyro.CFrame=CFrame.lookAt(rootPart.Position,targetPos)
        else break end
        if CheckLagback(rootPart,generation) then bodyVelocity:Destroy();bodyGyro:Destroy();return false end
        task.wait()
    end
    if not isTargetValid(targetRoot) then bodyVelocity:Destroy();bodyGyro:Destroy();movementExpected=false;antiStuckPaused=true;return true end
    local targetChar=targetRoot.Parent
    local targetVehicle=nil
    if targetChar:GetAttribute("InVehicle") then
        local vehiclesDir=workspace:FindFirstChild("Vehicles")
        if vehiclesDir then
            for _,v in pairs(vehiclesDir:GetChildren()) do
                local vSeat=GetVehicleSeat(v)
                if vSeat and (vSeat.Position-targetRoot.Position).Magnitude<15 then targetVehicle=v;break end
            end
        end
    end
    if not targetChar:GetAttribute("InVehicle") then
        print("[TARGET ON FOOT] Skipping tire pop and ramming phase...")
    elseif targetVehicle then
        local initialPop=targetVehicle:GetAttribute("VehicleTiresLastPop")
        local rStart=tick()
        local maxRamTime=math.max(Config.CarMaxRamDuration,0.8)
        while SessionValid(generation,char,rootPart) and isTargetValid(targetRoot) and tick()-rStart<maxRamTime do
            if CheckLagback(rootPart,generation) then bodyVelocity:Destroy();bodyGyro:Destroy();return false end
            pcall(function() sethiddenproperty(rootPart,"PhysicsRepRootPart",targetRoot) end)
            rootPart.CFrame=targetRoot.CFrame*Config.TpOffset
            bodyVelocity.Velocity=Vector3.zero
            local currentPop=targetVehicle:GetAttribute("VehicleTiresLastPop")
            if currentPop and initialPop and currentPop~=initialPop then break end
            if not targetChar:GetAttribute("InVehicle") or not targetVehicle:IsDescendantOf(workspace) then break end
            task.wait()
        end
        task.wait(Config.CarLoopTpDuration)
    else
        local tStart=tick()
        while SessionValid(generation,char,rootPart) and isTargetValid(targetRoot) and tick()-tStart<Config.CarLoopTpDuration do
            if CheckLagback(rootPart,generation) then bodyVelocity:Destroy();bodyGyro:Destroy();return false end
            pcall(function() sethiddenproperty(rootPart,"PhysicsRepRootPart",targetRoot) end)
            rootPart.CFrame=targetRoot.CFrame*Config.TpOffset
            bodyVelocity.Velocity=Vector3.zero
            task.wait()
        end
    end
    bodyVelocity.Velocity=Vector3.zero
    rootPart.AssemblyLinearVelocity=Vector3.zero
    rootPart.AssemblyAngularVelocity=Vector3.zero
    pcall(function() bodyVelocity:Destroy();bodyGyro:Destroy() end)
    movementExpected=false
    antiStuckPaused=true
    pcall(function()
        if ExitFunc then ExitFunc() end
        VirtualInputManager:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
    end)
    task.wait(0.2)
    if not SessionValid(generation,char,rootPart) then return false end
    currentVehicle=nil
    phaseState="VEHICLE_RETURN"
    return true
end
ExecuteAutoArrest=function()
    if ServerHopActive or automationStarting then return end
    automationStarting=true
    local char=LocalPlayer.Character
    if not char then char=LocalPlayer.CharacterAdded:Wait() end
    local humanoid=char:WaitForChild("Humanoid",10)
    local rootPart=char:WaitForChild("HumanoidRootPart",10)
    if not humanoid or not rootPart or LocalPlayer.Character~=char then automationStarting=false;return end
    if CheckServerHop() then automationStarting=false;return end
    automationGeneration+=1
    local generation=automationGeneration
    resetPending=false
    getgenv().AutoArrestActive=true
    getgenv().LagbackCount=0
    StopAllAutomation()
    sessionCharacter=char
    sessionHumanoid=humanoid
    sessionRoot=rootPart
    phaseState="PHASE_1"
    phase1Active=false
    phase1Complete=false
    phase1FinalPosition=nil
    currentTarget=nil
    targetRoot=nil
    lastCarExited=nil
    rememberedCar=nil
    currentVehicle=nil
    BindVehicleTracking(generation,char,humanoid)
    AddSessionConnection(humanoid.Died:Connect(function()
        if generation==automationGeneration then InvalidateAutomation("CHARACTER DIED",false) end
    end))
    AddSessionConnection(humanoid.HealthChanged:Connect(function(health)
        if health<=0 and generation==automationGeneration then InvalidateAutomation("HEALTH ZERO",false) end
    end))
    StartAntiStuckMonitor(generation,char,rootPart)
    automationStarting=false
    print("[AUTO ARREST] Starting Phase 1...")
    if not RunPhase1(generation,char,rootPart,humanoid) then return end
    while SessionValid(generation,char,rootPart) do
        if not ExecuteAutoArrestCycle(generation,char,rootPart,humanoid) then
            if generation~=automationGeneration or not getgenv().AutoArrestActive then return end
            if not (char:GetAttribute("InVehicle") or humanoid.SeatPart) then RequestCharacterReset("AUTOMATION STATE INVALID",generation);return end
        end
        task.wait(0.05)
    end
end
